{
  "$id": "https://auroraneuro.org/schemas/fiber-query-v0.4.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "fiber-query/0.4 is the bounded observed-context boundary for decision-relative rate-distortion. It carries the 0.3 loss/utility decision contract plus a normalized model prior, ordered observed evidence likelihoods, a compatible-model floor, and the required distortion tolerance. FIBER executes identification, an exhaustive frontier and minimal-context sufficiency; it never substitutes a sampled or implicit prior.",
  "properties": {
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_facts": { "minimum": 1, "type": "integer" },
        "max_tokens": { "minimum": 1, "type": "integer" }
      },
      "required": ["max_facts"],
      "type": "object"
    },
    "decision_loss": {
      "additionalProperties": false,
      "description": "Action-by-model table. Rows are actions and columns are models. With sense=utility, values are negated once into the compiler's internal loss convention.",
      "properties": {
        "actions": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "loss": {
          "items": {
            "items": { "type": "number" },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "models": {
          "items": { "maxLength": 256, "minLength": 1, "type": "string" },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "sense": { "default": "loss", "enum": ["loss", "utility"], "type": "string" }
      },
      "required": ["actions", "models", "loss"],
      "type": "object"
    },
    "decision_time": { "type": "string" },
    "distortion_tolerance": { "minimum": 0, "type": "number" },
    "goal": { "type": "string" },
    "permitted_actions": {
      "items": { "maxLength": 256, "minLength": 1, "type": "string" },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "policy": { "items": { "type": "string" }, "type": "array" },
    "protected_tags": { "items": { "type": "string" }, "type": "array" },
    "query_id": { "type": "string" },
    "rate_distortion": {
      "additionalProperties": false,
      "properties": {
        "compatibility_floor": { "maximum": 1, "minimum": 0, "type": "number" },
        "criterion": { "enum": ["bayes_regret", "minimax_regret"], "type": "string" },
        "evidence_pool": {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "cost": { "minimum": 0, "type": "number" },
                  "id": { "maxLength": 256, "minLength": 1, "type": "string" },
                  "likelihood": {
                    "items": { "minimum": 0, "type": "number" },
                    "maxItems": 1000,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": ["id", "cost", "likelihood"],
                "type": "object"
              },
              "maxItems": 16,
              "type": "array"
            }
          },
          "required": ["items"],
          "type": "object"
        },
        "prior": {
          "items": { "minimum": 0, "type": "number" },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["criterion", "compatibility_floor", "prior", "evidence_pool"],
      "type": "object"
    },
    "role": { "type": "string" },
    "schema_version": { "const": "fiber-query/0.4" },
    "targets": { "items": { "type": "string" }, "minItems": 1, "type": "array" }
  },
  "required": [
    "schema_version",
    "query_id",
    "targets",
    "protected_tags",
    "decision_time",
    "budgets",
    "decision_loss",
    "permitted_actions",
    "distortion_tolerance",
    "rate_distortion"
  ],
  "title": "AURORA FIBER Query 0.4",
  "type": "object"
}
