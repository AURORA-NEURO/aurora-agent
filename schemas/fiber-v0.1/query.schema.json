{
  "$id": "https://auroraneuro.org/schemas/fiber-query-v0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budgets": {
      "additionalProperties": false,
      "properties": {
        "max_facts": {
          "minimum": 1,
          "type": "integer"
        },
        "max_tokens": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_facts"
      ],
      "type": "object"
    },
    "decision_time": {
      "type": "string"
    },
    "distortion_tolerance": {
      "minimum": 0,
      "type": "number"
    },
    "policy": {
      "description": "Policy clauses the caller accepts as obligations, and therefore the grants this compile holds. Must be a subset of the clause list the world's `data_policy` fact declares, where the world declares one; a clause outside it is a policy conflict and the compile refuses. Facts whose `policy` scope names a clause absent from this list are withheld.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "protected_tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "query_id": {
      "type": "string"
    },
    "role": {
      "description": "Caller role. Carried by the contract and read by no compiler pass in v0.1; role and visibility filtering is not implemented.",
      "type": "string"
    },
    "schema_version": {
      "const": "fiber-query/0.1"
    },
    "targets": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "query_id",
    "targets",
    "protected_tags",
    "decision_time",
    "budgets"
  ],
  "title": "AURORA FIBER Query",
  "type": "object"
}
