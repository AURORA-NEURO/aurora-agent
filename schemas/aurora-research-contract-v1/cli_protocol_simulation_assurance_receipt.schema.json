{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/cli-protocol-simulation-assurance-receipt.json",
  "title": "AURORA CLI protocol simulation assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "purpose", "protocol_schema", "disposition", "required_step_order", "observed_step_order", "missing_step_order", "violation_order", "adversarial_event_order", "omissions", "uncertainty", "negative_evidence", "protocol_digest", "replay_identity", "provenance_digest", "verdict_digest", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "cli-federated-continual-protocol-simulation-assurance/1.0"},
    "feature_id": {"const": "AFA-cli-P10-F28"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "protocol_schema": {"const": "ProtocolDraft4@1"},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "required_step_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed_step_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_step_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "violation_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "adversarial_event_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "negative_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "verdict_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(verify:protocol-simulation:.+|block:unsafe-release)$"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.protocol-simulation-report+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
