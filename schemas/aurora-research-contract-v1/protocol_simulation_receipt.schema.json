{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/protocol_simulation_receipt.schema.json",
  "title": "AURORA prospective protocol simulation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "protocol_id", "design_digest", "results", "passed", "failed_closed", "approval_required", "omissions", "uncertainty", "semantic_loss", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "prospective-protocol-simulation/1.0"},
    "feature_id": {"const": "AFA-adapter-P10-F03"},
    "protocol_id": {"type": "string", "minLength": 1},
    "design_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["scenario_id", "state", "executed_steps", "retries", "compensations", "consumed_units", "reasons"], "properties": {"scenario_id": {"type": "string", "minLength": 1}, "state": {"enum": ["passed", "failed_closed", "approval_required"]}, "executed_steps": {"type": "array", "items": {"type": "string"}}, "retries": {"type": "integer", "minimum": 0}, "compensations": {"type": "array", "items": {"type": "string"}}, "consumed_units": {"type": "number", "minimum": 0}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": true}},
    "passed": {"type": "integer", "minimum": 0},
    "failed_closed": {"type": "integer", "minimum": 0},
    "approval_required": {"type": "integer", "minimum": 0},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
