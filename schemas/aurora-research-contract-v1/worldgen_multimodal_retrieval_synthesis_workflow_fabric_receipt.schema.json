{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/worldgen/multimodal-retrieval-synthesis-workflow/1.0",
  "title": "Worldgen multimodal retrieval synthesis workflow receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "workflow_id", "disposition", "stage_order", "completed_stage_order", "pending_stage_order", "compensation_order", "checkpoint_seq", "budget_units", "consumed_units", "replay_identity", "copilot", "workflow_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "worldgen-multimodal-retrieval-synthesis-workflow/1.0"}, "feature_id": {"const": "AFA-worldgen-P02-F14"}, "workflow_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "partial", "blocked"]},
    "stage_order": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "completed_stage_order": {"type": "array", "items": {"type": "string"}}, "pending_stage_order": {"type": "array", "items": {"type": "string"}}, "compensation_order": {"type": "array", "items": {"type": "string"}}, "checkpoint_seq": {"type": "integer", "minimum": 1}, "budget_units": {"type": "integer", "minimum": 1}, "consumed_units": {"type": "integer", "minimum": 0}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "copilot": {"type": "object", "required": ["schema_version", "contract_version", "feature_id", "request_id", "agent_id", "disposition", "action_order", "tool_receipts", "synthesis", "copilot_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"]}, "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_type", "content_hash", "boundary"], "properties": {"artifact_id": {"type": "string"}, "content_type": {"const": "application/vnd.aurora.worldgen.retrieval-workflow-receipt+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "raw_data_local": {"const": true}, "aggregate_only": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}

