{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/workflow-batch-receipt.json",
  "title": "AURORA high-throughput workflow batch receipt",
  "description": "Canonical batch ledger for typed research workflows with explicit success, dry-run, and blocked outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "total_workflows", "succeeded_workflows", "dry_run_workflows", "blocked_workflows", "entries", "artifact", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-runtime-P12-F11" },
    "total_workflows": { "type": "integer", "minimum": 1 },
    "succeeded_workflows": { "type": "integer", "minimum": 0 },
    "dry_run_workflows": { "type": "integer", "minimum": 0 },
    "blocked_workflows": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "disposition", "receipt_digest", "ordered_nodes", "reasons"],
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["succeeded", "dry_run", "blocked"] },
          "receipt_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "ordered_nodes": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
