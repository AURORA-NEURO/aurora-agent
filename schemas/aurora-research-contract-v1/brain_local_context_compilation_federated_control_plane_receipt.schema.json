{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-local-context-compilation-federated-control-plane-receipt.json",
  "title": "AURORA brain local context compilation federated control plane receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "node_id", "workflow_id", "scope", "goal", "disposition", "stage_order", "completed_order", "degraded_order", "unresolved_order", "denied_order", "exchange_order", "checkpoint_seq", "retry_count", "consumed_budget_units", "run_digest", "telemetry_digest", "federation_digest", "replay_identity", "witness_order", "counterexample_order", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "brain-local-context-compilation-federated-control-plane/1.0"},
    "feature_id": {"const": "AFA-brain-P03-F29"},
    "request_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["completed", "degraded", "unresolved", "denied"]},
    "stage_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completed_order": {"type": "array", "items": {"type": "string"}},
    "degraded_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "denied_order": {"type": "array", "items": {"type": "string"}},
    "exchange_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "retry_count": {"type": "integer", "minimum": 0},
    "consumed_budget_units": {"type": "integer", "minimum": 0},
    "run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "telemetry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "federation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witness_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterexample_order": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
