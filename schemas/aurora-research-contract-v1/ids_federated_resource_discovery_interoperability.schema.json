    "endpoint_order": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "qualified_order": {"type": "array", "items": {"type": "string"}}, "unresolved_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "missing_capability_order": {"type": "array", "items": {"type": "string"}},
