{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/interpretation-plane-receipt.schema.json",
  "title": "AURORA Interpretation Plane Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "disposition", "interpretation_order", "blocked_order", "replay_identity", "budget", "budget_remaining", "max_concurrency", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "ids-interpretation-federation/1.0"},
    "feature_id": {"const": "AFA-ids-P14-F31"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["admitted", "partial", "unknown", "blocked"]},
    "interpretation_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget": {"type": "integer", "minimum": 0},
    "budget_remaining": {"type": "integer", "minimum": 0},
    "max_concurrency": {"type": "integer", "minimum": 1},
    "checks": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash", "media_type", "scope"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
