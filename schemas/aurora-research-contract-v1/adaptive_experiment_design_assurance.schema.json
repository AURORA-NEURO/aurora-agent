{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/adaptive-experiment-design-assurance-9.json",
  "title": "AURORA adaptive prospective experiment-design assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "researcher", "purpose", "semantic_profile", "checkpoint", "disposition", "candidate_order", "ranked_order", "selected_order", "alternative_order", "unresolved_order", "blocked_order", "missing_candidate_order", "missing_study_order", "missing_modality_order", "peer_order", "qualified_peer_order", "missing_peer_order", "power_witness_order", "variance_witness_order", "attrition_witness_order", "replication_witness_order", "omission_order", "uncertainty_order", "contradiction_order", "negative_evidence_order", "replay_identity", "design_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adaptive-prospective-high-throughput-experiment-design-assurance/1.0"},
    "feature_id": {"const": "AFA-adaptive-P09-F27"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "researcher": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "integer", "minimum": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "candidate_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "ranked_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "selected_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "alternative_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocked_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_candidate_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_study_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_modality_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "peer_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "qualified_peer_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "missing_peer_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "power_witness_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "variance_witness_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "attrition_witness_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "replication_witness_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "omission_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contradiction_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "design_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "content_type", "content_hash", "semantic_loss", "provenance_digests", "boundary"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.experiment-design-assurance-receipt-9+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "string"}},
        "provenance_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
