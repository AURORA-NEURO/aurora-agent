{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/policy-interoperability-control-receipt.json",
  "title": "AURORA policy interoperability control receipt",
  "description": "Federated continual capability negotiation with explicit migration, policy, provenance, autonomy, and digest-only exchange gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "federation_id", "disposition", "offer_order", "accepted_order", "blocked_order", "unknown_order", "capability_order", "schema_order", "input_order", "output_order", "provenance_order", "evidence_order", "migration_order", "replay_identity", "benchmark_digest", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "integration_artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "policy-federated-interoperability-control-plane/1.0" },
    "feature_id": { "const": "AFA-policy-P22-F32" },
    "request_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "offer_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "accepted_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "capability_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "schema_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "input_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "output_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "evidence_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "migration_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "integration_artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
