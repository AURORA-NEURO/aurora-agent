{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/conformance_interpretation_visualization_interoperability_gateway.schema.json",
  "title":"Conformance Federated Continual Interpretation and Visualization Interoperability Gateway",
  "type":"object",
  "required":["schema_version","contract_version","feature_id","request_id","federation_id","researcher","purpose","semantic_profile","checkpoint","disposition","candidate_order","ranked_order","qualified_order","unresolved_order","blocked_order","incomparable_order","missing_study_order","missing_modality_order","missing_visualization_order","peer_order","qualified_peer_order","missing_peer_order","omission_order","uncertainty_order","contradiction_order","negative_evidence_order","support_witness","quorum_witness","replay_identity","interpretation_digest","artifact","effect_receipts","raw_data_local","aggregate_only","boundary"],
  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},
    "contract_version":{"const":"conformance-federated-continual-interpretation-visualization-interoperability-gateway/1.0"},
    "feature_id":{"const":"AFA-conformance-P14-F24"},
    "request_id":{"type":"string","minLength":1},"federation_id":{"type":"string","minLength":1},"researcher":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"checkpoint":{"type":"integer","minimum":1},
    "disposition":{"enum":["qualified","unresolved","blocked"]},
    "candidate_order":{"type":"array","items":{"type":"string"},"minItems":1},"ranked_order":{"type":"array","items":{"type":"string"},"minItems":1},"qualified_order":{"type":"array","items":{"type":"string"}},"unresolved_order":{"type":"array","items":{"type":"string"}},"blocked_order":{"type":"array","items":{"type":"string"}},"incomparable_order":{"type":"array","items":{"type":"string"}},"missing_study_order":{"type":"array","items":{"type":"string"}},"missing_modality_order":{"type":"array","items":{"type":"string"}},"missing_visualization_order":{"type":"array","items":{"type":"string"}},
    "peer_order":{"type":"array","items":{"type":"string"},"minItems":1},"qualified_peer_order":{"type":"array","items":{"type":"string"}},"missing_peer_order":{"type":"array","items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"contradiction_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},"support_witness":{"type":"array","items":{"type":"string"}},"quorum_witness":{"type":"array","items":{"type":"string"}},
    "replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"interpretation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","required":["artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.federated-interpretation-visualization-envelope-10+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array","items":{"type":"string"}},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}},"additionalProperties":false},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string"}},"raw_data_local":{"const":true},"aggregate_only":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "allOf":[{"if":{"properties":{"disposition":{"const":"qualified"}}},"then":{"properties":{"effect_receipts":{"minItems":1,"maxItems":1,"items":{"pattern":"^verify:interpretation-visualization:.+"}}}}},{"if":{"properties":{"disposition":{"enum":["unresolved","blocked"]}}},"then":{"properties":{"effect_receipts":{"const":["block:unsafe-release"]}}}}],
  "additionalProperties":false
}
