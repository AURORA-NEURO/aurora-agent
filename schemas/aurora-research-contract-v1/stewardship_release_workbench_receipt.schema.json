{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/stewardship_release_workbench_receipt.schema.json",
  "title": "AURORA Stewardship Federated Release Workbench Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "federation_id", "disposition", "object_order", "admitted_order", "blocked_order", "unknown_order", "origin_order", "artifact_order", "provenance_order", "evidence_order", "release_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "federation_manifest", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "stewardship-federated-release-workbench/1.0"},
    "feature_id": {"const": "AFA-stewardship-P16-F20"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "object_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "origin_order": {"type": "array", "items": {"type": "string"}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "release_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(exchange:signed-research-object-manifest:|block:release-workbench-publish$)"}, "minItems": 1},
    "federation_manifest": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
