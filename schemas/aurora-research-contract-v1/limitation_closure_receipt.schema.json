{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/limitation_closure_receipt.schema.json",
  "title": "AURORA adapter federated limitation closure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "disposition", "case_order", "resolved_order", "unresolved_order", "evidence_order", "omissions", "uncertainty", "negative_evidence", "reasons", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-limitation-closure/1.0"},
    "feature_id": {"const": "AFA-adapter-P26-F24"},
    "request_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["closed", "partial", "unknown", "blocked"]},
    "case_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resolved_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
