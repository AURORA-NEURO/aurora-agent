  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"bioethics-multimodal-context-compilation-assurance-harness/1.0"},"feature_id":{"const":"AFA-bioethics-P03-F26"},"request_id":{"type":"string","minLength":1},"consumer":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"target_scope":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"disposition":{"enum":["qualified","partial","blocked"]},
    "fact_order":{"type":"array","minItems":1,"items":{"type":"string"}},"selected_order":{"type":"array","items":{"type":"string"}},"unresolved_order":{"type":"array","items":{"type":"string"}},"blocked_order":{"type":"array","items":{"type":"string"}},"missing_study_order":{"type":"array","items":{"type":"string"}},"missing_modality_order":{"type":"array","items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},"ethical_gate_order":{"type":"array","items":{"type":"string"}},"replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"context_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.bioethics-certified-decision-section-7+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array","items":{"type":"string"}},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(block:unsafe-release|observe:context:[^\\s]+)$"}},"raw_data_local":{"const":true},"aggregate_only":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
