{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adversarial_recovery_receipt.schema.json",
  "title": "AURORA adapter adversarial recovery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "disposition", "event_order", "recovered_order", "blocked_order", "replay_order", "checkpoint_order", "recovery_digest", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-adversarial-recovery/1.0"},
    "feature_id": {"const": "AFA-adapter-P30-F24"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["recovered", "partial", "unknown", "blocked"]},
    "event_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "recovered_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocked_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "replay_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checkpoint_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "recovery_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
