{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/cli-retrieval-synthesis-assurance-receipt.json",
  "title": "AURORA CLI retrieval and synthesis assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "corpus_id", "scope", "query", "disposition", "candidate_order", "rank_order", "selected_order", "unresolved_order", "blocked_order", "required_source_order", "observed_source_order", "missing_source_order", "stale_order", "contradiction_order", "checks", "omissions", "uncertainty", "negative_evidence", "replay_identity", "evidence_digest", "artifact", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "cli-prospective-retrieval-synthesis-assurance/1.0"},
    "feature_id": {"const": "AFA-cli-P02-F27"},
    "request_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rank_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "selected_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "required_source_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed_source_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_source_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stale_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contradiction_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"],
      "properties": {
        "schema_version": {"const": "aurora-research-contract/1.0"},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.evidence-synthesis+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "array", "items": {"type": "object"}},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
