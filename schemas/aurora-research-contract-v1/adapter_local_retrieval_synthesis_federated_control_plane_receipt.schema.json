{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter-local-retrieval-synthesis-federated-control-plane-receipt.json",
  "title": "AURORA adapter local retrieval synthesis federated control plane receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "service_id", "node_id", "capacity", "active_runs", "admission", "scope", "workbench_digest", "health_digest", "replay_identity", "control_digest", "omissions", "uncertainty", "counterexamples", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-local-retrieval-synthesis-federated-control-plane/1.0"},
    "feature_id": {"const": "AFA-adapter-P02-F29"},
    "request_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "capacity": {"type": "integer", "minimum": 1},
    "active_runs": {"type": "integer", "minimum": 0},
    "admission": {"enum": ["admitted", "degraded", "approval_required", "blocked"]},
    "scope": {"type": "string", "minLength": 1},
    "workbench_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "health_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash", "media_type"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"const": "application/vnd.aurora.local-retrieval-synthesis-federated-control-plane+json"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
