{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/services_mechanism_workbench_receipt.schema.json",
  "title": "AURORA Services Prospective Mechanism Workbench Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "objective_id", "target_schema", "scope", "disposition", "ranked_order", "admitted_order", "blocked_order", "unknown_order", "mechanism_order", "study_order", "modality_order", "score_order", "artifact_order", "evidence_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "services-prospective-mechanism-workbench/1.0"},
    "feature_id": {"const": "AFA-services-P08-F19"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "target_schema": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "ranked_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocked_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mechanism_order": {"type": "array", "items": {"type": "string"}},
    "study_order": {"type": "array", "items": {"type": "string"}},
    "modality_order": {"type": "array", "items": {"type": "string"}},
    "score_order": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(write:local-mechanism-workbench:|block:mechanism-workbench-release$)"}, "minItems": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
