{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/qualified-analysis-result.json",
  "title": "AURORA qualified analysis result",
  "description": "Omission-aware qualification of declared statistical and causal analysis candidates without promoting identification gaps into certainty.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "question_id", "estimand", "verdict", "selected_candidate", "candidate_order", "uncertainty", "omissions", "negative_evidence", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-evalengine-P13-F01" },
    "question_id": { "type": "string", "minLength": 1 },
    "estimand": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["qualified", "conditional", "blocked"] },
    "selected_candidate": { "type": ["string", "null"] },
    "candidate_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "uncertainty": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
