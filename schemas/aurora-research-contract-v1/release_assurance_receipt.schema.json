{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/release_assurance_receipt.schema.json",
  "title": "AURORA multimodal research release assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "run_id", "release_id", "verdict", "study_order", "modality_order", "artifact_order", "evidence_receipt_order", "omissions", "uncertainty", "negative_evidence", "semantic_loss", "reasons", "policy_decision", "effect_receipt", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "multimodal-research-release-assurance/1.0"},
    "feature_id": {"const": "AFA-adapter-P16-F26"},
    "run_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["released", "conditional", "incomplete", "incomparable", "blocked"]},
    "study_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "modality_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_receipt_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policy_decision": {"enum": ["allow", "deny", "redact", "local_only", "approval_required", "unresolved"]},
    "effect_receipt": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
