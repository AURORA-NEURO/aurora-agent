{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/api-multimodal-interpretation-workflow-fabric-receipt.json",
  "title": "AURORA API multimodal interpretation workflow receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "scope", "semantic_profile", "query", "disposition", "stage_order", "study_order", "modality_order", "rank_order", "qualified_order", "unresolved_order", "blocked_order", "incomparable_order", "missing_modality_order", "panel_order", "action_receipts", "checks", "omissions", "uncertainty", "negative_evidence", "replay_identity", "comparability_digest", "workflow_digest", "artifact", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "api-multimodal-multi-study-interpretation-workflow-fabric/1.0"},
    "feature_id": {"const": "AFA-api-P14-F14"},
    "request_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "semantic_profile": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "stage_order": {"const": ["compile-context", "compare-studies", "render-interpretation", "retain-receipt"]},
    "study_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "modality_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "rank_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "qualified_order": {"type": "array", "items": {"type": "string"}}, "unresolved_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "incomparable_order": {"type": "array", "items": {"type": "string"}}, "missing_modality_order": {"type": "array", "items": {"type": "string"}}, "panel_order": {"type": "array", "items": {"type": "string"}}, "action_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "comparability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.interactive-interpretation+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
