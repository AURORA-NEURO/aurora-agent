{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/conformance-knowledge-world-assurance-receipt.json",
  "title": "AURORA conformance typed knowledge-world assurance receipt",
  "description": "A1 comparability and protected-closure gate for multimodal preclinical knowledge representation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "scope", "disposition", "candidate_order", "admitted_order", "blocked_order", "unknown_order", "predicate_order", "study_order", "modality_order", "support_order", "semantic_order", "artifact_order", "evidence_order", "provenance_order", "comparability_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "benchmark_digest", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "conformance-knowledge-world-assurance/1.0" },
    "feature_id": { "const": "AFA-conformance-P04-F26" },
    "request_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "candidate_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "admitted_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "predicate_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "study_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "modality_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "support_order": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 1000 } },
    "semantic_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "artifact_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "evidence_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "comparability_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": true },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
