{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/adapter-federated-continual-retrieval-synthesis-workflow-fabric-receipt.schema.json",
  "title": "AFA adapter P02 F16 federated continual retrieval synthesis workflow fabric receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract_version","feature_id","request_id","workflow_id","query_id","batch_id","checkpoint_id","checkpoint_seq","capacity","queue_digest","comparability_digest","federation_id","purpose","peer_ids","min_peer_quorum","aggregate_only","endpoint","federation_digest","disposition","stage_order","plan_order","completed_order","blocked_order","compensation_order","candidate_order","selected_order","omitted_order","overflow_order","uncertainty_order","negative_order","contradictory_order","synthesis_receipt_digest","checkpoint_digest","workflow_digest","replay_identity","budget_units","required_budget","omissions","uncertainty","negative_evidence","effect_receipts","artifact","raw_data_local","boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-federated-continual-retrieval-synthesis-workflow-fabric/1.0"},
    "feature_id": {"const": "AFA-adapter-P02-F16"},
    "request_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_seq": {"type": "integer", "minimum": 1}, "capacity": {"type": "integer", "minimum": 1},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "comparability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "federation_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "peer_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "min_peer_quorum": {"type": "integer", "minimum": 1}, "aggregate_only": {"const": true}, "endpoint": {"type": "string", "minLength": 1}, "federation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition": {"enum": ["passed","blocked","unknown"]},
    "stage_order": {"const": ["stage:checkpoint","stage:validate-federation","stage:admit-peer-quorum","stage:compile-synthesis","stage:seal-aggregate-envelope","stage:persist-artifact","stage:validate-output"]},
    "plan_order": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "completed_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "compensation_order": {"type": "array", "items": {"type": "string"}},
    "candidate_order": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "selected_order": {"type": "array", "items": {"type": "string"}}, "omitted_order": {"type": "array", "items": {"type": "string"}}, "overflow_order": {"type": "array", "items": {"type": "string"}}, "uncertainty_order": {"type": "array", "items": {"type": "string"}}, "negative_order": {"type": "array", "items": {"type": "string"}}, "contradictory_order": {"type": "array", "items": {"type": "string"}},
    "synthesis_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "budget_units": {"type": "integer", "minimum": 1}, "required_budget": {"type": "integer", "minimum": 1},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifact": {"type": "object", "required": ["content_hash","media_type"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"const": "application/vnd.aurora.federated-continual-retrieval-synthesis-workflow+json"}}, "additionalProperties": true},
    "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
