{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/interoperability_gateway_receipt.schema.json",
  "title": "AURORA federated interoperability gateway receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "endpoint_id", "negotiated_version", "disposition", "capability_order", "artifact_digest_order", "replay_token", "omissions", "uncertainty", "semantic_loss", "checks", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-interoperability-gateway/1.0"},
    "feature_id": {"const": "AFA-adapter-P22-F24"},
    "request_id": {"type": "string", "minLength": 1},
    "endpoint_id": {"type": "string", "minLength": 1},
    "negotiated_version": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["accepted", "migrated", "approval_required", "blocked", "incompatible", "unknown"]},
    "capability_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact_digest_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "replay_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
