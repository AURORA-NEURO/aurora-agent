{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/oncoworlds_federated_statistical_analysis_workbench.schema.json",
  "title": "OncoWorlds Federated Statistical Analysis Workbench Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "requester", "purpose", "federation_id", "semantic_profile", "disposition", "candidate_order", "selected_order", "unresolved_order", "blocked_order", "missing_order", "study_order", "modality_order", "model_order", "selected_study_order", "selected_modality_order", "selected_model_order", "missing_study_order", "missing_modality_order", "missing_model_order", "uncertainty_order", "omission_order", "negative_evidence_order", "replay_identity", "provenance_digest", "result_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "autonomy_tier", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "oncoworlds-federated-continual-statistical-causal-ml-analysis-research-workbench/1.0"},
    "feature_id": {"const": "AFA-oncoworlds-P13-F20"},
    "request_id": {"type": "string", "minLength": 1},
    "requester": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "approval_required", "unresolved", "blocked"]},
    "candidate_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "selected_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "missing_order": {"type": "array", "items": {"type": "string"}},
    "study_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "modality_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "model_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "selected_study_order": {"type": "array", "items": {"type": "string"}},
    "selected_modality_order": {"type": "array", "items": {"type": "string"}},
    "selected_model_order": {"type": "array", "items": {"type": "string"}},
    "missing_study_order": {"type": "array", "items": {"type": "string"}},
    "missing_modality_order": {"type": "array", "items": {"type": "string"}},
    "missing_model_order": {"type": "array", "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}},
    "omission_order": {"type": "array", "items": {"type": "string"}},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "required": ["schema_version", "artifact_id", "content_type", "content_hash", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string"}, "content_type": {"const": "application/vnd.aurora.oncoworlds-analysis-workbench-result-8+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "autonomy_tier": {"const": "a1"},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
