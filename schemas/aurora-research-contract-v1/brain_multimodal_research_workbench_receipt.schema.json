{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-multimodal-research-workbench-receipt.json",
  "title": "AURORA brain multimodal research workbench receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workspace_id", "scope", "study_order", "modality_order", "disposition", "view_order", "panel_order", "action_receipts", "candidate_order", "qualified_order", "blocked_order", "unknown_order", "evidence_digest", "comparability_digest", "workbench_digest", "replay_identity", "budget_units", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-multimodal-research-workbench/1.0"}, "feature_id": {"const": "AFA-brain-P01-F18"}, "request_id": {"type": "string", "minLength": 1}, "workspace_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "study_order": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "modality_order": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "view_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "panel_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "action_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "qualified_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "comparability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workbench_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "budget_units": {"type": "integer", "minimum": 1}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
