{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/workflow-execution-receipt.json",
  "title": "AURORA deterministic workflow execution receipt",
  "description": "A typed, policy-bound workflow order and replayable execution result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "workflow_id", "mode", "status", "ordered_nodes", "completed_nodes", "run", "run_digest", "remaining_budget", "artifact", "reasons", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-runtime-P12-F10" },
    "workflow_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["dry_run", "execute"] },
    "status": { "enum": ["dry_run", "succeeded"] },
    "ordered_nodes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "completed_nodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "run": {
      "type": "object",
      "required": ["workflow_id", "status"],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "running", "paused", "succeeded", "failed", "cancelled"] }
      }
    },
    "run_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "remaining_budget": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
    "artifact": {
      "type": "object",
      "required": ["content_hash"],
      "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
