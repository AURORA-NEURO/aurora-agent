{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-evidence-workflow-fabric-receipt.json",
  "title": "AURORA brain evidence workflow fabric receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "study_id", "scope", "disposition", "stage_order", "plan_order", "completed_order", "blocked_order", "compensation_order", "candidate_order", "qualified_order", "unknown_order", "evidence_receipt_digest", "checkpoint_digest", "workflow_digest", "replay_identity", "budget_units", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-evidence-surveillance-workflow-fabric/1.0"}, "feature_id": {"const": "AFA-brain-P01-F13"},
    "request_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "study_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "stage_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "plan_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "completed_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "compensation_order": {"type": "array", "items": {"type": "string"}}, "candidate_order": {"type": "array", "items": {"type": "string"}}, "qualified_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}},
    "evidence_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "budget_units": {"type": "integer", "minimum": 1},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
