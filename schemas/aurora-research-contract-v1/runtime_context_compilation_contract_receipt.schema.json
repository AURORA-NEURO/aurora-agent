{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/runtime-context-compilation-contract-receipt.json",
  "title": "AURORA runtime context compilation contract receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "query_id", "compatibility", "migration_order", "section", "checks", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "runtime-prospective-context-compilation-contract-model/1.0"},
    "feature_id": {"const": "AFA-runtime-P03-F07"},
    "query_id": {"type": "string", "minLength": 1},
    "compatibility": {"const": "compatible"},
    "migration_order": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"},
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "section_id", "query_id", "scope", "target", "selected_fact_order", "omitted_fact_order", "unresolved_fact_order", "contradicted_fact_order", "unknown_fact_order", "required_fact_order", "omission_certificate", "uncertainty", "negative_evidence", "semantic_digest", "replay_identity", "section_digest", "semantic_loss", "artifact", "boundary"],
      "properties": {
        "schema_version": {"const": "CertifiedDecisionSection2@1"}, "section_id": {"type": "string", "minLength": 1}, "query_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1},
        "selected_fact_order": {"type": "array", "items": {"type": "string"}}, "omitted_fact_order": {"type": "array", "items": {"type": "string"}}, "unresolved_fact_order": {"type": "array", "items": {"type": "string"}}, "contradicted_fact_order": {"type": "array", "items": {"type": "string"}}, "unknown_fact_order": {"type": "array", "items": {"type": "string"}}, "required_fact_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "omission_certificate": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
        "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "section_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.certified-decision-section+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    }
  }
}
