{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/experiment_design_receipt.schema.json",
  "title": "AURORA federated experiment design control receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "objective_id", "decision", "site_order", "assignments", "modality_coverage", "omitted_modalities", "comparability_conflicts", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-experiment-design-control-plane/1.0"},
    "feature_id": {"const": "AFA-adapter-P09-F30"},
    "request_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["admitted", "partial", "blocked"]},
    "site_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assignments": {"type": "array", "items": {"type": "object", "required": ["site_id", "modality", "instrument_profile", "budget", "authorized"], "properties": {"site_id": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1}, "instrument_profile": {"type": "string", "minLength": 1}, "budget": {"type": "number", "minimum": 0}, "authorized": {"const": true}}, "additionalProperties": true}},
    "modality_coverage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "omitted_modalities": {"type": "array", "items": {"type": "string"}},
    "comparability_conflicts": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
