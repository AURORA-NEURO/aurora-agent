{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/instrument_mesh_receipt.schema.json",
  "title": "AURORA federated laboratory-integration mesh receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "action_id", "decision", "candidate_order", "selected_instrument_id", "selected_site_id", "selected_protocol_profile", "satisfied_capabilities", "missing_capabilities", "missing_interlocks", "effect", "omissions", "uncertainty", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-laboratory-integration/1.0"},
    "feature_id": {"const": "AFA-adapter-P11-F04"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["admitted", "approval_required", "blocked", "unknown"]},
    "candidate_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "selected_instrument_id": {"type": ["string", "null"]},
    "selected_site_id": {"type": ["string", "null"]},
    "selected_protocol_profile": {"type": ["string", "null"]},
    "satisfied_capabilities": {"type": "array", "items": {"type": "string"}},
    "missing_capabilities": {"type": "array", "items": {"type": "string"}},
    "missing_interlocks": {"type": "array", "items": {"type": "string"}},
    "effect": {"type": ["object", "null"], "additionalProperties": true},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
