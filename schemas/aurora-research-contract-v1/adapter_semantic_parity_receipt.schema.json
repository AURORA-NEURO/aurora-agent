{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter_semantic_parity_receipt.schema.json",
  "title": "AURORA adapter semantic parity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "objective_id", "disposition", "adapter_order", "study_order", "schema_order", "semantic_digest", "modality_order", "artifact_order", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-semantic-parity/1.0"},
    "feature_id": {"const": "AFA-adapter-P28-F06"},
    "request_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["passed", "unknown", "blocked"]},
    "adapter_order": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "study_order": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "schema_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "semantic_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "modality_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
