{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-throughput-evidence-surveillance-assurance.json",
  "title": "AURORA worldgen throughput evidence surveillance assurance receipt",
  "description": "A1 prospective high-throughput evidence surveillance and qualification receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "study_id", "scope", "disposition", "candidate_order", "qualified_order", "blocked_order", "unknown_order", "source_order", "modality_order", "relevance_order", "semantic_order", "artifact_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "worldgen-throughput-evidence-surveillance-assurance/1.0" },
    "feature_id": { "const": "AFA-worldgen-P01-F27" },
    "request_id": { "type": "string", "minLength": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "candidate_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualified_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "modality_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "relevance_order": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 1000 } },
    "semantic_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "artifact_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash", "content_type", "boundary"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "content_type": { "const": "application/vnd.aurora.worldgen-qualified-evidence-set-7+json" }, "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" } }, "additionalProperties": true },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
