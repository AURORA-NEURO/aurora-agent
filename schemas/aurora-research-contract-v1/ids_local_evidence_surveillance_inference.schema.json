{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/ids-local-evidence-surveillance-inference.schema.json",
  "title":"AFA IDS local single-study evidence-surveillance inference result",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","feature_id","request_id","study_id","intent","scope","semantic_profile","disposition","candidate_order","qualified_order","blocked_order","unknown_order","omission_order","uncertainty_order","negative_evidence_order","replay_identity","evidence_digest","artifact","effect_receipts","raw_data_local","boundary"],
  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"ids-local-single-study-evidence-surveillance-inference-engine/1.0"},"feature_id":{"const":"AFA-ids-P01-F01"},
    "request_id":{"type":"string","minLength":1},"study_id":{"type":"string","minLength":1},"intent":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"disposition":{"enum":["qualified","unknown","blocked"]},
    "candidate_order":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"qualified_order":{"type":"array","items":{"type":"string"}},"blocked_order":{"type":"array","items":{"type":"string"}},"unknown_order":{"type":"array","items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},
    "replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["schema_version","artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"schema_version":{"const":"aurora-research-contract/1.0"},"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.ids-qualified-evidence-set-1+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array"},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(block:unsafe-release|read:local-research-artifacts:[^\\s]+)$"}},"raw_data_local":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
