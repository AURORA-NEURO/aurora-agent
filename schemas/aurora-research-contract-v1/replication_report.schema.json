{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/replication-report.json",
  "title": "AURORA replication and negative-result report",
  "description": "Deterministic independent-site replication disposition that preserves null and contradictory evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "artifact"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "feature_id", "capability_id", "request_digest", "summary", "observation_digests", "boundary"],
      "properties": {
        "schema_version": { "const": "aurora-research-contract/1.0" },
        "feature_id": { "const": "AFA-evalengine-P15-F01" },
        "capability_id": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "summary": {
          "type": "object",
          "required": ["disposition", "total_observations", "independent_sites", "positive_count", "null_count", "negative_count", "inconclusive_count", "reasons"],
          "properties": {
            "disposition": { "enum": ["replicated", "partially_replicated", "contradicted", "null_result", "insufficient_evidence"] },
            "total_observations": { "type": "integer", "minimum": 1 },
            "independent_sites": { "type": "integer", "minimum": 0 },
            "positive_count": { "type": "integer", "minimum": 0 },
            "null_count": { "type": "integer", "minimum": 0 },
            "negative_count": { "type": "integer", "minimum": 0 },
            "inconclusive_count": { "type": "integer", "minimum": 0 },
            "effect_min": { "type": ["number", "null"] },
            "effect_max": { "type": ["number", "null"] },
            "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "observation_digests": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["site", "assay", "outcome", "artifact_digest", "independent", "preregistered"], "properties": { "site": { "type": "string", "minLength": 1 }, "assay": { "type": "string", "minLength": 1 }, "outcome": { "enum": ["positive", "null", "negative", "inconclusive"] }, "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "independent": { "type": "boolean" }, "preregistered": { "type": "boolean" } } } },
        "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
      }
    },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }
  }
}
