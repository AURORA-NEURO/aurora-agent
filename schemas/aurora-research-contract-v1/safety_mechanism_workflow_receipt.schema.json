{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/safety-mechanism-workflow-receipt.json",
  "title": "AURORA safety mechanism workflow receipt",
  "description": "Fail-closed federated mechanism workflow scheduling with replay, checkpoint, autonomy, evidence, and action-boundary gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "federation_id", "disposition", "candidate_order", "ranked_order", "admitted_order", "blocked_order", "unknown_order", "mechanism_order", "evidence_order", "provenance_order", "action_order", "replay_identity", "benchmark_digest", "checkpoint_id", "checkpoint_digest", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "workflow_artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "safety-federated-mechanism-workflow/1.0" },
    "feature_id": { "const": "AFA-safety-P08-F16" },
    "request_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "candidate_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "ranked_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "admitted_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mechanism_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "action_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "checkpoint_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "workflow_artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
