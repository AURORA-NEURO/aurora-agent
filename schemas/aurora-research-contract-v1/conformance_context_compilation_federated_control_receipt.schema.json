{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/conformance-context-compilation-federated-control-receipt.json",
  "title": "AURORA conformance context-compilation federated control receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "service_id", "federation_id", "purpose", "batch_id", "admission", "peer_order", "accepted_peer_order", "incompatible_peer_order", "candidate_order", "admitted_order", "conditional_order", "blocked_order", "unknown_order", "decisions", "checkpoint_seq", "checkpoint_digest", "queue_digest", "control_digest", "replay_identity", "semantic_loss", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "conformance-prospective-context-compilation-federated-control-plane/1.0"},
    "feature_id": {"const": "AFA-conformance-P03-F31"},
    "request_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "admission": {"enum": ["admitted", "degraded", "approval_required", "blocked", "unknown"]},
    "peer_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "accepted_peer_order": {"type": "array", "items": {"type": "string"}},
    "incompatible_peer_order": {"type": "array", "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "conditional_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "disposition", "failed_gates", "conditional_gates", "negative_result"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["admitted", "conditional", "blocked"]},
          "failed_gates": {"type": "array", "items": {"type": "string"}},
          "conditional_gates": {"type": "array", "items": {"type": "string"}},
          "negative_result": {"type": "boolean"}
        }
      }
    },
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"],
      "properties": {
        "schema_version": {"const": "aurora-research-contract/1.0"},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.conformance-context-control+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "array", "items": {"type": "object"}},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}


