{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/interweave-frontier-control-receipt.schema.json",
  "title": "Interweave prospective frontier control receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "service_id", "federation_id", "purpose", "batch_id", "admission", "peer_order", "job_order", "decisions", "checkpoint_seq", "checkpoint_digest", "queue_digest", "control_digest", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "interweave-prospective-frontier-control-plane/1.0"},
    "feature_id": {"const": "AFA-interweave-P25-F31"},
    "request_id": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "admission": {"enum": ["admitted", "degraded", "approval_required", "blocked", "unknown"]},
    "peer_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "accepted_peer_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "incompatible_peer_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "job_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conditional_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocked_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unknown_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["job_id", "disposition", "failed_gates", "conditional_gates", "negative_result"], "properties": {"job_id": {"type": "string", "minLength": 1}, "disposition": {"type": "string"}, "failed_gates": {"type": "array", "items": {"type": "string"}}, "conditional_gates": {"type": "array", "items": {"type": "string"}}, "negative_result": {"type": "boolean"}}}},
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.interweave-control+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}


