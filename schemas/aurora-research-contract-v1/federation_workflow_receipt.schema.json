{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/federation_workflow_receipt.schema.json",
  "title": "AURORA prospective federation workflow receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "workflow_id", "decision", "task_order", "checkpoint_order", "compensation_order", "total_budget_units", "omissions", "uncertainty", "semantic_loss", "reasons", "effect_receipt", "envelope", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "prospective-federation-workflow-fabric/1.0"},
    "feature_id": {"const": "AFA-adapter-P20-F15"},
    "workflow_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["scheduled", "approval_required", "local_only", "partial", "blocked"]},
    "task_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checkpoint_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compensation_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "total_budget_units": {"type": "integer", "minimum": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "effect_receipt": {"type": "string", "minLength": 1},
    "envelope": {"type": "object", "minProperties": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
