{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/fiber_federated_resource_workbench.schema.json",
  "title": "AFA-fiber-P05-F20 federated resource discovery workbench",
  "type": "object",
