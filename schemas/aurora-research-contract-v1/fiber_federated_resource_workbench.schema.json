  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "fiber-federated-continual-resource-discovery-research-workbench/1.0"}, "feature_id": {"const": "AFA-fiber-P05-F20"},
    "request_id": {"type": "string", "minLength": 1}, "need_id": {"type": "string", "minLength": 1}, "requester": {"type": "string", "minLength": 1}, "intent": {"type": "string", "minLength": 1}, "semantic_profile": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "candidate_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "ranked_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "selected_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "unresolved_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "blocked_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "missing_candidate_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "site_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "selected_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "missing_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "omission_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "uncertainty_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "negative_evidence_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "resource_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.fiber-qualified-resource-set-5+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "raw_data_local": {"const": true}, "aggregate_only": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
