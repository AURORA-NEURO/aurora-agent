{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/api-analysis-assurance-receipt.json",
  "title": "AURORA API federated analysis assurance receipt",
  "description": "Evidence- and policy-gated qualification of federated statistical, causal, and ML analysis candidates without exporting raw preclinical data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "question_id", "disposition", "result_id", "estimand", "candidate_order", "admitted_order", "blocked_order", "selected_candidate", "class_order", "result_order", "model_order", "evidence_order", "provenance_order", "replay_identity", "benchmark_digest", "evidence_receipt_digest", "artifact", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "api-federated-analysis-assurance/1.0" },
    "feature_id": { "const": "AFA-api-P13-F28" },
    "request_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "question_id": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "result_id": { "type": "string", "minLength": 1 },
    "estimand": { "type": "string", "minLength": 1 },
    "candidate_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "admitted_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "selected_candidate": { "type": ["string", "null"] },
    "class_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "result_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "model_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "evidence_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_receipt_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
