{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/adapter_federated_continual_retrieval_synthesis_research_workbench_receipt.schema.json",
  "title": "Federated continual retrieval synthesis research workbench receipt",
  "type": "object",
  "required": ["schema_version","contract_version","feature_id","request_id","workspace_id","workflow_id","query_id","scope","intent","federation_id","purpose","peer_ids","min_peer_quorum","aggregate_only","endpoint","disposition","view_order","panel_order","candidate_order","selected_order","omitted_order","overflow_order","uncertainty_order","negative_order","contradictory_order","replay_identity","workflow_run_digest","workbench_digest","omissions","uncertainty","negative_evidence","effect_receipts","artifact","raw_data_local","boundary"],
  "properties": {
    "schema_version": {"const":"aurora-research-contract/1.0"},
    "contract_version": {"const":"adapter-federated-continual-retrieval-synthesis-research-workbench/1.0"},
    "feature_id": {"const":"AFA-adapter-P02-F20"},
    "request_id": {"type":"string","minLength":1}, "workspace_id":{"type":"string","minLength":1}, "workflow_id":{"type":"string","minLength":1}, "query_id":{"type":"string","minLength":1}, "scope":{"type":"string","minLength":1}, "intent":{"type":"string","minLength":1}, "federation_id":{"type":"string","minLength":1}, "purpose":{"type":"string","minLength":1}, "endpoint":{"type":"string","minLength":1},
    "peer_ids":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"uniqueItems":true}, "min_peer_quorum":{"type":"integer","minimum":1}, "aggregate_only":{"const":true}, "disposition":{"enum":["passed","blocked","unknown"]},
    "view_order":{"const":["view:overview","view:peers","view:omissions","view:provenance"]}, "panel_order":{"const":["panel:aggregate","panel:negative","panel:provenance","panel:quorum"]},
    "candidate_order":{"type":"array","items":{"type":"string"},"minItems":1}, "selected_order":{"type":"array","items":{"type":"string"}}, "omitted_order":{"type":"array","items":{"type":"string"}}, "overflow_order":{"type":"array","items":{"type":"string"}}, "uncertainty_order":{"type":"array","items":{"type":"string"}}, "negative_order":{"type":"array","items":{"type":"string"}}, "contradictory_order":{"type":"array","items":{"type":"string"}}, "omissions":{"type":"array","items":{"type":"string"}}, "uncertainty":{"type":"array","items":{"type":"string"}}, "negative_evidence":{"type":"array","items":{"type":"string"}}, "effect_receipts":{"type":"array","items":{"type":"string"},"minItems":1},
    "replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"}, "workflow_run_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}, "workbench_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","required":["content_hash"],"properties":{"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"media_type":{"const":"application/vnd.aurora.federated-continual-retrieval-synthesis-research-workbench+json"}},"additionalProperties":true},
    "raw_data_local":{"const":true}, "boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "additionalProperties": false
}
