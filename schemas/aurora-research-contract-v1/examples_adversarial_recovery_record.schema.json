{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/examples-adversarial-recovery-record.json",
  "title": "AURORA examples adversarial recovery record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "case_id", "scenario_id", "scope", "disposition", "event_order", "recovered_order", "pending_order", "blocked_order", "compensated_order", "class_order", "replay_identity", "recovery_digest", "semantic_loss", "omissions", "uncertainty", "negative_evidence", "artifact", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "examples-federated-continual-adversarial-recovery-contract/1.0"}, "feature_id": {"const": "AFA-examples-P30-F08"}, "case_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "disposition": {"enum": ["recovered", "unresolved", "partial", "blocked"]},
    "event_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "recovered_order": {"type": "array", "items": {"type": "string"}}, "pending_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "compensated_order": {"type": "array", "items": {"type": "string"}}, "class_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recovery_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.examples-recovery-record+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
