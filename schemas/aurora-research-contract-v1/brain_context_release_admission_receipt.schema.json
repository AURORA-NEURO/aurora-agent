{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-context-release-admission-receipt.json","title":"AURORA brain context release admission receipt","type":"object","additionalProperties":false,"required":["schema_version","contract_version","feature_id","request_id","disposition","actor","action","context_digest","omission_certificate_digest","replay_identity","policy_decision","policy_reasons","grant_scope","grant_expiry","remaining_units","release_digest","effect_receipts","artifact","boundary"],"properties":{"schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"brain-context-release-admission/1.0"},"feature_id":{"const":"AFA-brain-P03-F06"},"request_id":{"type":"string","minLength":1},"disposition":{"enum":["admitted","blocked","approval_required","unresolved"]},"actor":{"type":"string","minLength":1},"action":{"const":"release:local-context"},"context_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"omission_certificate_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"policy_decision":{"enum":["allow","deny","redact","local_only","approval_required","unresolved"]},"policy_reasons":{"type":"array","minItems":1,"items":{"type":"string"}},"grant_scope":{"type":"string","minLength":1},"grant_expiry":{"type":"string","minLength":1},"remaining_units":{"type":"number","minimum":0},"release_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"effect_receipts":{"type":"array","minItems":1,"items":{"type":"string"}},"artifact":{"type":"object","required":["content_hash"],"properties":{"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}}
