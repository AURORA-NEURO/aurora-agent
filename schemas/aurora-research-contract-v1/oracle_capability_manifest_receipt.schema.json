{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/oracle_capability_manifest_receipt.schema.json",
  "title": "AURORA Oracle Capability Manifest Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "feature_id", "manifest_id", "request_id",
    "workflow_id", "benchmark_id", "scope", "disposition", "admitted_order", "blocked_order",
    "evidence_order", "provenance_order", "source_receipt_digest", "benchmark_digest",
    "replay_identity", "budget", "budget_remaining", "checks", "omissions", "uncertainty",
    "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"
  ],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "oracle-contract-frontier-assurance/1.0"},
    "feature_id": {"const": "AFA-oracle-P25-F27"},
    "manifest_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["admitted", "partial", "unknown", "blocked"]},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "source_receipt_digest": {"$ref": "#/$defs/digest"},
    "benchmark_digest": {"$ref": "#/$defs/digest"},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "budget": {"type": "integer", "minimum": 0},
    "budget_remaining": {"type": "integer", "minimum": 0},
    "checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "media_type", "scope"],
      "properties": {
        "content_hash": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
