{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/evaluation_assurance_receipt.schema.json",
  "title": "AURORA evaluation assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "run_id", "capability_id", "benchmark_id", "baseline_id", "verdict", "metric_order", "gate_order", "witness_order", "counterexample_order", "omissions", "uncertainty", "negative_evidence", "reasons", "effect_receipts", "replay_identity", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "evaluation-assurance-harness/1.0"},
    "feature_id": {"const": "AFA-adapter-P23-F25"},
    "run_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["passed", "conditional", "unknown", "blocked"]},
    "metric_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "gate_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "witness_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "counterexample_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
