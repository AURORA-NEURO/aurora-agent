{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/knowledge-representation-assurance-receipt.json",
  "title": "AURORA federated knowledge representation assurance receipt",
  "description": "Omission-aware admission for continual typed knowledge projections across research institutions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "request_id", "federation_id", "query_id", "resolved_fact_ids", "disposition", "evidence_receipt_digest", "checks", "omissions", "artifact", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-ops-P04-F28" },
    "contract_version": { "const": "federated-knowledge-representation-assurance/1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "resolved_fact_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "disposition": { "enum": ["passed", "blocked", "unknown"] },
    "evidence_receipt_digest": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }] },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
