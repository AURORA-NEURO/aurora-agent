  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"scope-prospective-high-throughput-evidence-surveillance-federated-control-plane/1.0"},"feature_id":{"const":"AFA-scope-P01-F31"},"request_id":{"type":"string","minLength":1},"batch_id":{"type":"string","minLength":1},"partition":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"checkpoint_seq":{"type":"integer","minimum":1},"disposition":{"enum":["qualified","unresolved","blocked"]},
