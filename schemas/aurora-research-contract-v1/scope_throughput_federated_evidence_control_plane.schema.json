    "replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"checkpoint_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"control_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["schema_version","artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"schema_version":{"const":"aurora-research-contract/1.0"},"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.scope-federated-evidence-control-receipt-9+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array"},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
