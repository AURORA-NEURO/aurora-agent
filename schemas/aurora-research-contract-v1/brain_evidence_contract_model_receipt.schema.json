{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-evidence-contract-model-receipt.json",
  "title": "AURORA brain evidence contract model receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "study_id", "scope", "disposition", "compatibility", "input_schema", "output_schema", "required_order", "provided_order", "missing_order", "semantic_loss_order", "semantic_digest", "artifact_digest", "provenance_digest", "contract_digest", "replay_identity", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-evidence-contract-model/1.0"}, "feature_id": {"const": "AFA-brain-P01-F05"},
    "request_id": {"type": "string", "minLength": 1}, "study_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]}, "compatibility": {"enum": ["additive", "migration_required", "breaking", "unknown"]}, "input_schema": {"const": "EvidenceFeed1@1"}, "output_schema": {"const": "QualifiedEvidenceSet2@1"},
    "required_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "provided_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "missing_order": {"type": "array", "items": {"type": "string"}}, "semantic_loss_order": {"type": "array", "items": {"type": "string"}},
    "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
