{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/hubapi_quality_assurance_receipt.schema.json",
  "title": "AURORA Hub API Quality-Control Assurance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "object_id", "study_id", "scope", "target_schema", "disposition", "ranked_metric_order", "passed_order", "failed_order", "unknown_order", "witness_order", "modality_order", "artifact_order", "evidence_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "feature_id": {"const": "AFA-hubapi-P07-F27"},
    "contract_version": {"const": "hubapi-quality-assurance/1.0"},
    "object_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "target_schema": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "conditional", "unknown", "blocked"]},
    "ranked_metric_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "passed_order": {"type": "array", "items": {"type": "string"}},
    "failed_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "witness_order": {"type": "array", "items": {"type": "string"}},
    "modality_order": {"type": "array", "items": {"type": "string"}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"const": "block:unsafe-release"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
