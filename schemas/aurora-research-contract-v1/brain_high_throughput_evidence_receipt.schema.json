{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-high-throughput-evidence-receipt.json",
  "title": "AURORA brain high-throughput evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "batch_id", "partition", "disposition", "candidate_order", "admitted_order", "blocked_order", "unknown_order", "relevance_order", "omissions", "uncertainty", "negative_evidence", "checkpoint_seq", "queue_digest", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "brain-evidence-surveillance-throughput/1.0"},
    "feature_id": {"const": "AFA-brain-P01-F03"},
    "request_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "partition": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "admitted_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}},
    "relevance_order": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 1000}}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "checkpoint_seq": {"type": "integer", "minimum": 1}, "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
