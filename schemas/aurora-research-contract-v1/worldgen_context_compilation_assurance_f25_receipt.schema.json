{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/context_compilation_assurance_receipt.schema.json",
  "title": "ContextAssuranceReceipt1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^AFA-worldgen-P03-F(25|26|27|28)$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "blocked"
      ]
    },
    "baseline_discovery_rate_milli": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_discovery_rate_milli": {
      "type": "integer",
      "minimum": 0
    },
    "delta_discovery_rate_milli": {
      "type": "integer"
    },
    "required_site_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "achieved_site_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_site_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked"
      ]
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "benchmark_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assurance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object"
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "benchmark_id",
    "disposition",
    "baseline_discovery_rate_milli",
    "candidate_discovery_rate_milli",
    "delta_discovery_rate_milli",
    "required_site_order",
    "achieved_site_order",
    "missing_site_order",
    "context_disposition",
    "context_digest",
    "benchmark_digest",
    "replay_identity",
    "assurance_digest",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "effect_receipts",
    "artifact",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ]
}
