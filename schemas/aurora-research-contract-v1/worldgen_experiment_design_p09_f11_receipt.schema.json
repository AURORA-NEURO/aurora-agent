{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-experiment-design-p09-f11.json",
  "title": "AFA-worldgen-P09-F11 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "question_id",
    "disposition",
    "action_order",
    "admitted_action_order",
    "denied_action_order",
    "experiment design_disposition",
    "portfolio_digest",
    "copilot_digest",
    "replay_identity",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "effect_receipts",
    "raw_data_local",
    "aggregate_only",
    "boundary",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "const": "worldgen-throughput-experiment-design-copilot/1.0"
    },
    "feature_id": {
      "const": "AFA-worldgen-P09-F11"
    },
    "question_id": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked",
        "compatible"
      ]
    },
    "action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admitted_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experiment_design_disposition": {
      "type": "string"
    },
    "portfolio_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "copilot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "content_type",
        "content_hash",
        "boundary"
      ],
      "properties": {
        "content_type": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "required_design_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
