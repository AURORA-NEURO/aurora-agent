{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/fiber_mechanism_assurance_receipt.schema.json",
  "title": "AURORA FIBER Mechanism Exploration Assurance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "question_id", "workflow_id", "target_schema", "disposition", "ranked_order", "admitted_order", "blocked_order", "unknown_order", "mechanism_order", "study_order", "modality_order", "artifact_order", "evidence_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "feature_id": {"const": "AFA-fiber-P08-F26"},
    "contract_version": {"const": "fiber-mechanism-assurance/1.0"},
    "question_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "target_schema": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "conditional", "unknown", "blocked"]},
    "ranked_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "mechanism_order": {"type": "array", "items": {"type": "string"}},
    "study_order": {"type": "array", "items": {"type": "string"}},
    "modality_order": {"type": "array", "items": {"type": "string"}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"const": "block:unsafe-release"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
