{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/lab_evidence_surveillance_receipt.schema.json",
  "title": "AURORA Lab Evidence Surveillance Copilot Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "feed_id", "workflow_id", "disposition", "qualified_order", "blocked_order", "unknown_order", "source_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "feature_id": {"const": "AFA-lab-P01-F11"},
    "contract_version": {"const": "evidence-surveillance-copilot/1.0"},
    "feed_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "qualified_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "source_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "anyOf": [{"pattern": "^invoke:declared-tools:"}, {"const": "block:evidence-surveillance-release"}]}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
