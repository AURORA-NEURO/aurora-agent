{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/weavelang-computational-execution-assurance.schema.json",
  "title": "AFA-weavelang-P12-F25 local computational-execution assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "actor_id", "disposition", "node_order", "selected_order", "unresolved_order", "blocked_order", "missing_dependency_order", "cycle_order", "unauthorized_effect_order", "budget_exhausted_order", "omission_order", "uncertainty_order", "negative_evidence_order", "replay_identity", "run_digest", "artifact", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "weavelang-local-computational-execution-assurance-harness/1.0"},
    "feature_id": {"const": "AFA-weavelang-P12-F25"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "node_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "selected_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "missing_dependency_order": {"type": "array", "items": {"type": "string"}},
    "cycle_order": {"type": "array", "items": {"type": "string"}},
    "unauthorized_effect_order": {"type": "array", "items": {"type": "string"}},
    "budget_exhausted_order": {"type": "array", "items": {"type": "string"}},
    "omission_order": {"type": "array", "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.weavelang-execution-run-7+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
