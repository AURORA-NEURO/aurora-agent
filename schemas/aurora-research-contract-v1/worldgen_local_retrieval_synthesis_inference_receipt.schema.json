{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/worldgen/local-retrieval-synthesis-inference/1.0",
  "title": "Worldgen local retrieval synthesis inference receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "researcher", "corpus_id", "semantic_profile", "disposition", "candidate_order", "ranked_order", "selected_order", "unresolved_order", "blocked_order", "source_order", "omission_order", "uncertainty_order", "negative_evidence_order", "ranked_scores_milli", "total_units", "replay_identity", "synthesis_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "worldgen-local-retrieval-synthesis-inference/1.0"},
    "feature_id": {"const": "AFA-worldgen-P02-F01"},
    "request_id": {"type": "string", "minLength": 1},
    "researcher": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "candidate_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "ranked_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "selected_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "source_order": {"type": "array", "items": {"type": "string"}},
    "omission_order": {"type": "array", "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}},
    "ranked_scores_milli": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1},
    "total_units": {"type": "integer", "minimum": 0},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "synthesis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_type", "content_hash", "boundary"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.worldgen.evidence-synthesis-1+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
