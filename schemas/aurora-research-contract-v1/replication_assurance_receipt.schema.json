{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/replication_assurance_receipt.schema.json",
  "title": "AURORA federated replication assurance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "claim_id", "protocol_digest", "verdict", "observation_order", "independent_site_order", "positive_count", "null_count", "negative_count", "inconclusive_count", "omissions", "uncertainty", "negative_evidence", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-replication-assurance/1.0"},
    "feature_id": {"const": "AFA-adapter-P15-F28"},
    "claim_id": {"type": "string", "minLength": 1},
    "protocol_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["replicated", "partially_replicated", "contradicted", "null_result", "insufficient_evidence", "blocked"]},
    "observation_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "independent_site_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "positive_count": {"type": "integer", "minimum": 0},
    "null_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "inconclusive_count": {"type": "integer", "minimum": 0},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
