{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/dataops-provenance-signing-workflow-fabric.json",
  "title": "AURORA Dataops provenance signing workflow fabric receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "batch_id", "capacity", "active_jobs", "semantic_profile", "disposition", "artifact_order", "verified_order", "unresolved_order", "blocked_order", "missing_parent_order", "cycle_order", "invalid_signature_order", "root_mismatch_order", "omission_order", "uncertainty_order", "negative_evidence_order", "root_digest", "replay_identity", "signature_mode", "receipt_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "dataops-prospective-high-throughput-provenance-signing-workflow-fabric/1.0"}, "feature_id": {"const": "AFA-dataops-P18-F15"},
    "request_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "capacity": {"type": "integer", "minimum": 1}, "active_jobs": {"type": "integer", "minimum": 0}, "semantic_profile": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "artifact_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}, "verified_order": {"type": "array", "items": {"type": "string"}}, "unresolved_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "missing_parent_order": {"type": "array", "items": {"type": "string"}}, "cycle_order": {"type": "array", "items": {"type": "string"}}, "invalid_signature_order": {"type": "array", "items": {"type": "string"}}, "root_mismatch_order": {"type": "array", "items": {"type": "string"}}, "omission_order": {"type": "array", "items": {"type": "string"}}, "uncertainty_order": {"type": "array", "items": {"type": "string"}}, "negative_evidence_order": {"type": "array", "items": {"type": "string"}},
    "root_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signature_mode": {"const": "detached-digest-attestation"}, "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_type", "content_hash", "semantic_loss", "provenance_digests", "boundary"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.dataops-provenance-signing-workflow+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {}}, "provenance_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(verify:provenance-envelope:.+|block:unsafe-release)$"}, "minItems": 1}, "raw_data_local": {"const": true}, "aggregate_only": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}


