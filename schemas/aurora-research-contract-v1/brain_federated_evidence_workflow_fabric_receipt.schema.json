{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-federated-evidence-workflow-fabric-receipt.json",
  "title": "AURORA brain federated evidence workflow fabric receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "federation_id", "institution_id", "purpose", "endpoint", "disposition", "stage_order", "plan_order", "completed_order", "blocked_order", "compensation_order", "candidate_order", "admitted_order", "unknown_order", "aggregate_order", "checkpoint_digest", "workflow_digest", "approval_reference", "replay_identity", "budget_units", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "brain-federated-evidence-workflow-fabric/1.0"},
    "feature_id": {"const": "AFA-brain-P01-F16"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "stage_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "plan_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completed_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "compensation_order": {"type": "array", "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "aggregate_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_reference": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget_units": {"type": "integer", "minimum": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
