{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter_composition_receipt.schema.json",
  "title": "AURORA multimodal adapter dependency composition receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "objective_id", "disposition", "component_order", "selected_order", "missing_capability_order", "dependency_order", "modality_order", "artifact_order", "omissions", "uncertainty", "negative_evidence", "reasons", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-dependency-composition/1.0"},
    "feature_id": {"const": "AFA-adapter-P27-F18"},
    "request_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["composed", "partial", "unknown", "blocked"]},
    "component_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "selected_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_capability_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependency_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "modality_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
