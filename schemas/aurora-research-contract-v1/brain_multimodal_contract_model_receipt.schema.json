{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-multimodal-contract-model-receipt.json",
  "title": "AURORA brain multimodal evidence contract model receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "study_order", "scope", "comparability_profile", "disposition", "compatibility", "input_schema", "output_schema", "modality_order", "binding_order", "missing_order", "semantic_disagreement_order", "schema_order", "unit_order", "coordinate_order", "semantic_order", "artifact_order", "provenance_order", "contract_digest", "replay_identity", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-multimodal-evidence-contract/1.0"}, "feature_id": {"const": "AFA-brain-P01-F06"}, "request_id": {"type": "string", "minLength": 1}, "study_order": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "scope": {"type": "string", "minLength": 1}, "comparability_profile": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]}, "compatibility": {"enum": ["additive", "migration_required", "breaking", "unknown"]}, "input_schema": {"const": "EvidenceFeed2@1"}, "output_schema": {"const": "QualifiedEvidenceSet2@1"},
    "modality_order": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "binding_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "missing_order": {"type": "array", "items": {"type": "string"}}, "semantic_disagreement_order": {"type": "array", "items": {"type": "string"}}, "schema_order": {"type": "array", "items": {"type": "string"}}, "unit_order": {"type": "array", "items": {"type": "string"}}, "coordinate_order": {"type": "array", "items": {"type": "string"}},
    "semantic_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "artifact_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "provenance_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
