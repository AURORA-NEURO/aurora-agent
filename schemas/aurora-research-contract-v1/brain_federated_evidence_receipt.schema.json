{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-federated-evidence-receipt.json",
  "title": "AURORA brain federated evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "institution_id", "purpose", "semantic_profile", "endpoint", "disposition", "candidate_order", "admitted_order", "blocked_order", "unknown_order", "aggregate_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-evidence-surveillance-federated/1.0"}, "feature_id": {"const": "AFA-brain-P01-F04"},
    "request_id": {"type": "string", "minLength": 1}, "federation_id": {"type": "string", "minLength": 1}, "institution_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "semantic_profile": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]}, "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "admitted_order": {"type": "array", "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}}, "aggregate_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
