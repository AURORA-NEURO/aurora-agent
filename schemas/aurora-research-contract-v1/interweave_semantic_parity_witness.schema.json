{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/interweave-semantic-parity-witness.json",
  "title": "AURORA interweave semantic parity witness",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "fixture_id", "batch_id", "scope", "disposition", "parity_order", "matched_order", "missing_order", "mismatch_order", "uncertain_order", "omission_order", "invocation_receipt", "replay_identity", "witness_digest", "semantic_loss", "omissions", "uncertainty", "negative_evidence", "artifact", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "interweave-prospective-semantic-parity-research-copilot/1.0"}, "feature_id": {"const": "AFA-interweave-P28-F11"}, "fixture_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "unresolved", "approval_required", "blocked"]},
    "parity_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "matched_order": {"type": "array", "items": {"type": "string"}}, "missing_order": {"type": "array", "items": {"type": "string"}}, "mismatch_order": {"type": "array", "items": {"type": "string"}}, "uncertain_order": {"type": "array", "items": {"type": "string"}}, "omission_order": {"type": "array", "items": {"type": "string"}}, "invocation_receipt": {"type": "string", "minLength": 1}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "witness_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.interweave-parity-witness+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array", "items": {"type": "object"}}, "provenance": {"type": "array", "items": {"type": "object"}}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
