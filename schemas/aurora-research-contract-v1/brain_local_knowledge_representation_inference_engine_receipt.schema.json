{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-local-knowledge-representation-inference-engine-receipt.json",
  "title": "AURORA brain local knowledge representation inference engine receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "study_id", "disposition", "candidate_order", "admitted_order", "unresolved_order", "denied_order", "world_digest", "evidence_digest", "provenance_digest", "replay_identity", "witness_order", "counterexample_order", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "brain-local-knowledge-representation-inference-engine/1.0"},
    "feature_id": {"const": "AFA-brain-P04-F01"},
    "request_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["completed", "partial", "unresolved", "denied"]},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "denied_order": {"type": "array", "items": {"type": "string"}},
    "world_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witness_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterexample_order": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
