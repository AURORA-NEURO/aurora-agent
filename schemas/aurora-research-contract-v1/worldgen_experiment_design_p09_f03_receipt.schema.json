{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-experiment-design-p09-f03.json",
  "title": "AFA-worldgen-P09-F03 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "purpose",
    "semantic_profile",
    "disposition",
    "replication_milli_order",
    "attrition_milli_order",
    "variance_milli_order",
    "power_milli_order",
    "objective",
    "candidate_order",
    "selected_order",
    "unresolved_order",
    "blocked_order",
    "omitted_order",
    "omissions",
    "uncertainty",
    "contradiction",
    "negative_evidence",
    "replay_identity",
    "portfolio_digest",
    "effect_receipts",
    "raw_data_local",
    "aggregate_only",
    "boundary",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "const": "worldgen-throughput-experiment-design/1.0"
    },
    "feature_id": {
      "const": "AFA-worldgen-P09-F03"
    },
    "request_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "semantic_profile": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked",
        "compatible"
      ]
    },
    "candidate_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradiction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "portfolio_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "content_type",
        "content_hash",
        "boundary"
      ],
      "properties": {
        "content_type": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "objective": {
      "type": "string"
    },
    "power_milli_order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "variance_milli_order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "attrition_milli_order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "replication_milli_order": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "required_design_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
