{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/bioworlds-federated-context-research-workbench-receipt.json",
  "title": "AURORA bioworlds federated context research workbench receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "purpose", "scope", "goal", "semantic_profile", "verdict", "institution_order", "candidate_order", "qualified_order", "blocked_order", "unknown_order", "stale_order", "aggregate_order", "quorum", "minimum_quorum", "envelope_digest", "verification_digest", "replay_identity", "witness_order", "counterexample_order", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "bioworlds-federated-continual-context-research-workbench/1.0"},
    "feature_id": {"const": "AFA-bioworlds-P03-F20"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["qualified", "unresolved", "blocked"]},
    "institution_order": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualified_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "stale_order": {"type": "array", "items": {"type": "string"}},
    "aggregate_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "quorum": {"type": "integer", "minimum": 0},
    "minimum_quorum": {"type": "integer", "minimum": 1},
    "envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witness_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterexample_order": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash", "content_type", "boundary"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_type": {"const": "application/vnd.aurora.bioworlds-federated-context-research-workbench+json"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
