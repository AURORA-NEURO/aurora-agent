{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/federated-multimodal-assurance-receipt.json",
  "title": "AURORA federated multimodal assurance receipt",
  "description": "Locality-preserving policy and harmonization gates for federated preclinical modality manifests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "request_id", "federation_id", "benchmark_id", "institution_ids", "disposition", "harmonized_digest", "checks", "omissions", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-routing-P06-F28" },
    "contract_version": { "const": "federated-multimodal-assurance/1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "institution_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "disposition": { "enum": ["passed", "blocked", "unknown"] },
    "harmonized_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
