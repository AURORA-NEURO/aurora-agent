{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/devx-local-evidence-surveillance-control-plane.schema.json",
  "title":"AFA DevX local single-study evidence-surveillance control receipt",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","feature_id","request_id","study_id","scope","requester","purpose","semantic_profile","disposition","candidate_order","qualified_order","unresolved_order","blocked_order","missing_order","omission_order","uncertainty_order","negative_evidence_order","replay_identity","control_digest","artifact","effect_receipts","raw_data_local","aggregate_only","boundary"],
  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"devx-local-single-study-evidence-surveillance-federated-control-plane/1.0"},"feature_id":{"const":"AFA-devx-P01-F29"},"request_id":{"type":"string","minLength":1},"study_id":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"requester":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"disposition":{"enum":["qualified","partial","blocked"]},
    "candidate_order":{"type":"array","minItems":1,"items":{"type":"string"}},"qualified_order":{"type":"array","items":{"type":"string"}},"unresolved_order":{"type":"array","items":{"type":"string"}},"blocked_order":{"type":"array","items":{"type":"string"}},"missing_order":{"type":"array","items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},"replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"control_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.devx-evidence-control-receipt-8+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array","items":{"type":"string"}},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(block:unsafe-release|read:local-research-artifacts:[^\\s]+)$"}},"raw_data_local":{"const":true},"aggregate_only":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
