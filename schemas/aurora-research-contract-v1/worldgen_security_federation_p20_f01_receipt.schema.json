{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFA-worldgen-P20-F01 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "consumer",
    "purpose",
    "origin",
    "destination",
    "policy_epoch",
    "disposition",
    "action_order",
    "admitted_order",
    "local_only_order",
    "denied_order",
    "unresolved_order",
    "omission_order",
    "threat_order",
    "revocation_order",
    "replay_identity",
    "federation_digest",
    "artifact",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "const": "AFA-worldgen-P20-F01"
    },
    "request_id": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "policy_epoch": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "admitted",
        "local_only",
        "blocked",
        "unresolved"
      ]
    },
    "action_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "admitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "local_only_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omission_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "threat_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revocation_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "federation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_type",
        "content_hash",
        "provenance_digests",
        "semantic_loss",
        "boundary"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "content_type": {
          "const": "application/vnd.aurora.worldgen.security-federation-receipt-1+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "semantic_loss": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary": {
          "const": "preclinical-research"
        }
      }
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "const": "preclinical-research"
    }
  }
}
