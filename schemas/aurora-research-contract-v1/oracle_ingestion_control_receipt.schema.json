{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/oracle_ingestion_control_receipt.schema.json",
  "title": "AURORA Oracle Federated Multimodal Ingestion Control Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "federation_id", "disposition", "modality_order", "accepted_order", "blocked_order", "unknown_order", "study_order", "semantic_profile_order", "artifact_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "aggregate_manifest", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "oracle-federated-multimodal-ingestion-control/1.0"},
    "feature_id": {"const": "AFA-oracle-P06-F30"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "modality_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "accepted_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "study_order": {"type": "array", "items": {"type": "string"}},
    "semantic_profile_order": {"type": "array", "items": {"type": "string"}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(exchange:aggregate-ingestion-manifest:|block:federated-ingestion-release$)"}, "minItems": 1},
    "aggregate_manifest": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
