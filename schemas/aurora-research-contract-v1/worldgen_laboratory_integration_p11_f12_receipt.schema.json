        "content_hash",
        "boundary"
      ],
      "properties": {
        "boundary": {
          "type": "string"
        },
        "content_type": {
          "const": "application/vnd.aurora.worldgen.laboratory-integration-copilot-receipt+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "laboratory_integration_disposition": {
      "type": "string"
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "question_id": {
      "type": "string"
    },
    "portfolio_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_version": {
      "const": "worldgen-federated-continual-laboratory-integration-copilot/1.0"
    },
    "disposition": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "boundary": {
      "type": "string"
    },
    "action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "copilot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "denied_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_data_local": {
      "const": true
    },
    "admitted_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_id": {
      "const": "AFA-worldgen-P11-F12"
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
