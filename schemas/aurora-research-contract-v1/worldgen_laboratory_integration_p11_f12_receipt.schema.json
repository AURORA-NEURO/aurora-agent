{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-laboratory-integration-p11-f12.json",
  "title": "AFA-worldgen-P11-F12 receipt",
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "question_id",
    "disposition",
    "action_order",
    "admitted_action_order",
    "denied_action_order",
    "laboratory_integration_disposition",
    "portfolio_digest",
    "copilot_digest",
    "replay_identity",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "effect_receipts",
    "raw_data_local",
    "aggregate_only",
    "boundary",
    "artifact"
  ],
  "properties": {
    "aggregate_only": {
      "const": true
    },
    "artifact": {
      "type": "object",
