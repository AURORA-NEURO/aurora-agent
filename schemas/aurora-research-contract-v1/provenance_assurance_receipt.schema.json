{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/provenance_assurance_receipt.schema.json",
  "title": "AURORA multimodal provenance assurance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "envelope_id", "root_artifact_id", "root_digest", "verdict", "lineage_order", "derivation_order", "study_order", "modality_order", "tool_order", "omissions", "uncertainty", "negative_evidence", "semantic_loss", "reasons", "signer_public_key_hex", "signer_signature_hex", "effect_receipt", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "multimodal-provenance-signing-assurance/1.0"},
    "feature_id": {"const": "AFA-adapter-P18-F26"},
    "envelope_id": {"type": "string", "minLength": 1},
    "root_artifact_id": {"type": "string", "minLength": 1},
    "root_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["signed", "conditional", "unresolved", "contradicted", "blocked"]},
    "lineage_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "derivation_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "study_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "modality_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tool_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "signer_public_key_hex": {"type": "string"},
    "signer_signature_hex": {"type": "string"},
    "effect_receipt": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
