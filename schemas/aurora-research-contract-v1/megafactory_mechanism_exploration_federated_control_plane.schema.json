{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/megafactory_mechanism_exploration_federated_control_plane.schema.json",
  "title": "Megafactory federated continual mechanism exploration control receipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "purpose", "semantic_profile", "admission", "mechanism_order", "rank_order", "decisions", "checkpoint_digest", "control_digest", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "megafactory-federated-continual-mechanism-control-plane/1.0"},
    "feature_id": {"const": "AFA-megafactory-P08-F32"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "admission": {"enum": ["admitted", "approval_required", "blocked", "unknown"]},
    "origin_order": {"type": "array", "items": {"type": "string"}},
    "admitted_origin_order": {"type": "array", "items": {"type": "string"}},
    "mechanism_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rank_order": {"type": "array", "items": {"type": "string"}},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "conditional_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "control_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_type", "content_hash"], "properties": {"content_type": {"const": "application/vnd.aurora.federated-mechanism-portfolio+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
