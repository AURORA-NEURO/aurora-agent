{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/resource-discovery-contract-receipt.json",
  "title": "AURORA MCP resource-discovery contract v2 receipt",
  "description": "Compatibility envelope preserving typed resource qualification semantics, migration notes, and deterministic artifact metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "request_id", "requested_by", "compatibility_profile", "result", "migration_notes", "artifact", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-mcp-P05-F08" },
    "contract_version": { "const": "aurora-mcp-resource-discovery/2.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "compatibility_profile": { "type": "string", "minLength": 1, "maxLength": 256 },
    "result": {
      "type": "object",
      "required": ["feature_id", "boundary"],
      "properties": {
        "feature_id": { "const": "AFA-fiber-P05-F20" },
        "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
      }
    },
    "migration_notes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
