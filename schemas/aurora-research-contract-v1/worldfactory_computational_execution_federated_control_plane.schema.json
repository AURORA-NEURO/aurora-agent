    "omission_order": {"type": "array", "items": {"type": "string"}}, "uncertainty_order": {"type": "array", "items": {"type": "string"}}, "negative_evidence_order": {"type": "array", "items": {"type": "string"}}, "adversarial_event_order": {"type": "array", "items": {"type": "string"}},
