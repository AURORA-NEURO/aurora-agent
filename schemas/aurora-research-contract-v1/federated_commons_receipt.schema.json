{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/federated-commons-receipt.schema.json",
  "title": "AURORA Federated Commons Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "contract_version", "feature_id", "request_id", "federation_id",
    "objective_id", "required_purpose", "disposition", "institution_order", "admitted_order",
    "denied_order", "semantic_profile_order", "artifact_order", "checks", "omissions",
    "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"
  ],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-federated-commons/1.0"},
    "feature_id": {"const": "AFA-adapter-P31-F22"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "required_purpose": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["shared", "partial", "unknown", "blocked"]},
    "institution_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "denied_order": {"type": "array", "items": {"type": "string"}},
    "semantic_profile_order": {"type": "array", "items": {"type": "string"}},
    "artifact_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifact": {
      "type": "object",
      "required": ["content_hash"],
      "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "additionalProperties": true
    },
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
