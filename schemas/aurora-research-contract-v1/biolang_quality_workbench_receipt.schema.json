{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/biolang_quality_workbench_receipt.schema.json",
  "title": "AURORA Biolang Prospective High-throughput Quality Workbench Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "study_id", "disposition", "summary", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "biolang-prospective-quality-workbench/1.0"},
    "feature_id": {"const": "AFA-biolang-P07-F19"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["released", "conditional", "quarantined", "unknown", "blocked"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_id", "disposition", "observation_order", "qualified_order", "warning_order", "quarantined_order", "unknown_order", "batch_order", "sample_order", "metric_order", "artifact_order", "provenance_order", "passed_count", "warning_count", "quarantined_count", "unknown_count", "omissions", "uncertainty", "negative_evidence", "replay_identity", "summary_digest", "boundary"],
      "properties": {
        "summary_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["released", "conditional", "quarantined", "unknown", "blocked"]},
        "observation_order": {"type": "array", "items": {"type": "string"}},
        "qualified_order": {"type": "array", "items": {"type": "string"}},
        "warning_order": {"type": "array", "items": {"type": "string"}},
        "quarantined_order": {"type": "array", "items": {"type": "string"}},
        "unknown_order": {"type": "array", "items": {"type": "string"}},
        "batch_order": {"type": "array", "items": {"type": "string"}},
        "sample_order": {"type": "array", "items": {"type": "string"}},
        "metric_order": {"type": "array", "items": {"type": "string"}},
        "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "passed_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "quarantined_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0},
        "omissions": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "array", "items": {"type": "string"}},
        "negative_evidence": {"type": "array", "items": {"type": "string"}},
        "replay_identity": {"$ref": "#/$defs/digest"},
        "summary_digest": {"$ref": "#/$defs/digest"},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^write:local-quality-manifest:"}, "minItems": 1},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
