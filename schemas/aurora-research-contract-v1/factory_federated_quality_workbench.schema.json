{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/mcp_federated_quality_control_assurance.schema.json",
  "title": "AFA-factory-P07-F20 federated continual quality-control verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "requester", "purpose", "semantic_profile", "disposition", "observation_order", "selected_observation_order", "unresolved_observation_order", "blocked_observation_order", "site_order", "selected_site_order", "unresolved_site_order", "blocked_site_order", "missing_site_order", "modality_order", "passed_modality_order", "missing_modality_order", "omission_order", "uncertainty_order", "negative_evidence_order", "qualified_site_count", "aggregate_pass_fraction_milli", "replay_identity", "report_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "factory-federated-continual-quality-workbench/1.0"},
    "feature_id": {"const": "AFA-factory-P07-F20"},
    "request_id": {"type": "string", "minLength": 1},
    "requester": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "observation_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "selected_observation_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unresolved_observation_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blocked_observation_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "site_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "selected_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unresolved_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "blocked_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "missing_site_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "modality_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "passed_modality_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "missing_modality_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "omission_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "negative_evidence_order": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "qualified_site_count": {"type": "integer", "minimum": 0},
    "aggregate_pass_fraction_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"],
      "properties": {
        "schema_version": {"const": "aurora-research-contract/1.0"},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.factory-quality-verdict-5+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "array", "items": {"type": "object"}},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "effect_receipts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
