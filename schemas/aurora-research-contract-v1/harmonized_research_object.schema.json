{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/harmonized-research-object.json",
  "title": "AURORA harmonized multimodal research object",
  "description": "Manifest-level imaging and omics alignment with explicit comparability, semantic loss, omissions, and local raw-data retention.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "study_id", "reference_schema", "decision", "modality_order", "alignment", "omitted_modalities", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-adapter-P06-F02" },
    "study_id": { "type": "string", "minLength": 1 },
    "reference_schema": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["comparable", "partial", "blocked"] },
    "modality_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "alignment": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "omitted_modalities": { "type": "array", "items": { "type": "string" } },
    "semantic_loss": { "type": "array", "items": { "type": "object" } },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
