{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/computational_execution_receipt.schema.json",
  "title": "AURORA computational execution control-plane receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "run_id", "decision", "ordered_nodes", "admitted_nodes", "run", "run_digest", "authorized_effects", "omissions", "uncertainty", "semantic_loss", "reasons", "artifact", "effects_executed", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "computational-execution-control-plane/1.0"},
    "feature_id": {"const": "AFA-adapter-P12-F31"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["dry_run", "admitted", "approval_required", "blocked"]},
    "ordered_nodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "admitted_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "run": {"type": "object", "required": ["workflow_id", "status"], "properties": {"workflow_id": {"type": "string"}, "status": {"const": "planned"}}, "additionalProperties": true},
    "run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_effects": {"type": "array", "items": {"type": "object", "required": ["node_id", "effect", "authorized", "executed", "payload_digest"], "properties": {"node_id": {"type": "string"}, "effect": {"const": "execute_local_computation"}, "authorized": {"const": true}, "executed": {"const": false}, "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "effects_executed": {"const": false},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
