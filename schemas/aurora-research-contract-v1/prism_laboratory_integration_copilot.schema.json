{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/prism-laboratory-integration-copilot.schema.json",
  "title":"AFA prism federated laboratory integration copilot receipt",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","feature_id","request_id","consumer","purpose","instrument_id","action_id","declared_tool","scope","semantic_profile","disposition","gate_order","omission_order","uncertainty_order","negative_evidence_order","replay_identity","action_digest","artifact","effect_receipts","raw_data_local","aggregate_only","boundary"],
  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"prism-federated-continual-laboratory-integration-research-copilot/1.0"},"feature_id":{"const":"AFA-prism-P11-F12"},"request_id":{"type":"string","minLength":1},"consumer":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"instrument_id":{"type":"string","minLength":1},"action_id":{"type":"string","minLength":1},"declared_tool":{"type":"string","minLength":1},"scope":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"disposition":{"enum":["qualified","blocked"]},"gate_order":{"type":"array","minItems":1,"items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},"replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"action_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.prism-instrument-action-receipt-3+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array","items":{"type":"string"}},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(block:unsafe-release|invoke:declared-tool:[^\\s]+)$"}},"raw_data_local":{"const":true},"aggregate_only":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
