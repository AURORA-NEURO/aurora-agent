{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/runtime_interpretation_assurance.schema.json",
  "title": "Runtime Federated Continual Interpretation Assurance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "request_id", "candidate_order", "qualified", "unresolved", "blocked", "incomparable", "missing_study_order", "missing_modality_order", "omissions", "uncertainty", "negative_results", "replay_identity", "interpretation_digest", "artifact", "effect_receipts", "locality", "boundary"],
  "properties": {
    "schema_version": {"const": "InteractiveInterpretation7@1"},
    "feature_id": {"const": "AFA-runtime-P14-F28"},
    "contract_version": {"const": "runtime-federated-continual-interpretation-assurance/1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "candidate_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "qualified": {"type": "array", "items": {"type": "string"}},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "blocked": {"type": "array", "items": {"type": "string"}},
    "incomparable": {"type": "array", "items": {"type": "string"}},
    "missing_study_order": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "missing_modality_order": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_results": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "minLength": 1},
    "interpretation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "required": ["artifact_id", "content_type", "content_hash"], "properties": {"artifact_id": {"type": "string"}, "content_type": {"const": "application/vnd.aurora.runtime-interactive-interpretation-7+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(block:unsafe-release)$"}, "const": ["block:unsafe-release"]},
    "locality": {"const": "raw-data-local; aggregate-only federation"},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
