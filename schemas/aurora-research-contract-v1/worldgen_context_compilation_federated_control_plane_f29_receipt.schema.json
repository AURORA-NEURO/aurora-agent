{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/context_compilation_federated_control_plane_receipt.schema.json",
  "title": "ContextControlPlaneReceipt1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^AFA-worldgen-P03-F(29|30|31|32)$"
    },
    "program_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "blocked"
      ]
    },
    "candidate_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "site_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admitted_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object"
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "program_id",
    "disposition",
    "candidate_order",
    "admitted_order",
    "unresolved_order",
    "blocked_order",
    "site_order",
    "action_order",
    "admitted_action_order",
    "denied_action_order",
    "replay_identity",
    "control_digest",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "effect_receipts",
    "artifact",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ]
}
