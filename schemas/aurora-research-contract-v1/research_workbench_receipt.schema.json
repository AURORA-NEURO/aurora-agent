{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/research_workbench_receipt.schema.json",
  "title": "AURORA multimodal research workbench receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "workspace_id", "disposition", "study_order", "modality_order", "view_order", "panel_order", "artifact_order", "omissions", "uncertainty", "negative_evidence", "action_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "multimodal-research-workbench/1.0"},
    "feature_id": {"const": "AFA-adapter-P24-F18"},
    "workspace_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["ready", "partial", "blocked", "local_only"]},
    "study_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "modality_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "view_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "panel_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact_order": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "action_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
