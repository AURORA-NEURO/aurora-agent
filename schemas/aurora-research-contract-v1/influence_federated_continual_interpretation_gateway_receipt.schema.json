{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/influence-federated-continual-interpretation-gateway-receipt.json",
  "title": "AURORA federated continual interpretation gateway receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "result_id", "consumer", "scope", "institution_id", "federation_id", "epoch", "negotiated_version", "disposition", "verdict", "peer_order", "accepted_peer_order", "capability_order", "claim_order", "interpretation_order", "influence_order", "covered_modalities", "omitted_modalities", "omissions", "uncertainty", "negative_evidence", "semantic_loss", "checks", "passed_checks", "counterexamples", "replay_identity", "federation_digest", "interpretation_digest", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "influence-federated-continual-interpretation-gateway/1.0"},
    "feature_id": {"const": "AFA-influence-P14-F24"},
    "result_id": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "institution_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "negotiated_version": {"const": "1.0.0"},
    "disposition": {"enum": ["accepted", "migrated", "approval_required", "blocked", "incompatible", "unknown"]},
    "verdict": {"enum": ["qualified", "conditional", "unknown", "blocked"]},
    "peer_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "accepted_peer_order": {"type": "array", "items": {"type": "string"}},
    "capability_order": {"type": "array", "items": {"type": "string"}},
    "claim_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "interpretation_order": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "modality", "statement", "bound_factor_order", "uncertainty", "negative_evidence"], "properties": {
        "claim_id": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "bound_factor_order": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "string", "minLength": 1}, "negative_evidence": {"type": "array", "items": {"type": "string"}}
      }}
    },
    "influence_order": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["factor_id", "modality", "evidence_state", "estimate", "attempted", "evidence_digest", "provenance_digest", "negative_result"], "properties": {
        "factor_id": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1}, "evidence_state": {"enum": ["proven", "supported", "speculative", "contradicted", "unknown"]}, "estimate": {"enum": ["bounded", "unknown"]}, "bound": {"type": "number", "minimum": 0, "maximum": 1}, "selected_method": {"type": "string"}, "attempted": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["method"], "properties": {"method": {"type": "string"}, "value": {"type": "number", "minimum": 0, "maximum": 1}, "declined": {"type": "string"}}}}, "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "negative_result": {"type": "boolean"}
      }}
    },
    "covered_modalities": {"type": "array", "items": {"type": "string"}}, "omitted_modalities": {"type": "array", "items": {"type": "string"}}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object", "required": ["field", "reason", "severity"], "properties": {"field": {"type": "string"}, "reason": {"type": "string"}, "severity": {"enum": ["none", "bounded", "decision_relevant", "unknown"]}}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "passed_checks": {"type": "array", "items": {"type": "string"}}, "counterexamples": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "federation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "interpretation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string"}, "content_type": {"const": "application/vnd.aurora.interactive-interpretation+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}, "additionalProperties": true},
    "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
