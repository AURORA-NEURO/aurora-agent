{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-multimodal-ingestion-p06-f06.json",
  "title": "AFA-worldgen-P06-F06 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "bundle_id",
    "consumer",
    "disposition",
    "required_modality_order",
    "object_order",
    "harmonized_order",
    "missing_order",
    "stale_order",
    "blocked_order",
    "unknown_order",
    "omitted_order",
    "semantic_loss_order",
    "objects",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "replay_identity",
    "ingestion_digest",
    "effect_receipts",
    "raw_data_local",
    "aggregate_only",
    "boundary",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "const": "worldgen-multimodal-multimodal-ingestion-contract_model/1.0"
    },
    "feature_id": {
      "const": "AFA-worldgen-P06-F06"
    },
    "bundle_id": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked"
      ]
    },
    "required_modality_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "object_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "harmonized_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stale_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_loss_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ingestion_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "content_type",
        "content_hash",
        "raw_objects",
        "boundary"
      ],
      "properties": {
        "content_type": {
          "const": "application/vnd.aurora.worldgen.multimodal-ingestion-receipt+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "raw_objects": {
          "const": false
        },
        "boundary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "x_aurora_boundary": "preclinical-research-only",
  "x_aurora_feature_tier": "product-capability"
}
