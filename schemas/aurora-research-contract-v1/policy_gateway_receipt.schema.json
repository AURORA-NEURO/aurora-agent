{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/policy_gateway_receipt.schema.json",
  "title": "AURORA federated policy autonomy gateway receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "action_id", "decision", "required_tier", "permitted_actions", "budget_order", "reasons", "uncertainty", "effect_receipt", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-policy-autonomy-gateway/1.0"},
    "feature_id": {"const": "AFA-adapter-P19-F24"},
    "request_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allowed", "approval_required", "local_only", "denied", "unresolved"]},
    "required_tier": {"enum": ["a0", "a1", "a2", "a3", "a4"]},
    "permitted_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "budget_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "effect_receipt": {"type": "string", "minLength": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
