{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter-federated-continual-evidence-surveillance-contract-model-receipt.json",
  "title": "AURORA adapter federated continual evidence surveillance contract model receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "input_schema", "output_schema", "federation_id", "purpose", "endpoint", "semantic_profile", "compatibility", "disposition", "peer_order", "candidate_order", "retained_order", "unknown_order", "denied_order", "aggregate_order", "migration_order", "semantic_loss", "federation_digest", "envelope_digest", "contract_digest", "canonical_digest", "provenance_digest", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "adapter-federated-continual-evidence-surveillance-contract-model/1.0"}, "feature_id": {"const": "AFA-adapter-P01-F08"},
    "request_id": {"type": "string", "minLength": 1}, "input_schema": {"const": "EvidenceFeed4@1"}, "output_schema": {"const": "QualifiedEvidenceSet2@1"}, "federation_id": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "minLength": 1}, "semantic_profile": {"type": "string", "minLength": 1},
    "compatibility": {"enum": ["compatible", "additive_migration", "breaking", "incompatible"]}, "disposition": {"enum": ["compatible", "partial", "unknown", "blocked"]},
    "peer_order": {"type": "array", "items": {"type": "string"}}, "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "retained_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}}, "denied_order": {"type": "array", "items": {"type": "string"}}, "aggregate_order": {"type": "array", "items": {"type": "string"}}, "migration_order": {"type": "array", "items": {"type": "string"}}, "semantic_loss": {"type": "array", "items": {"type": "string"}},
    "federation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
