{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/federated-knowledge-gateway-receipt.json",
  "title": "AURORA federated knowledge gateway receipt",
  "description": "Manifest-only knowledge-store interoperability admission with explicit projection, policy, and locality gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "contract_version", "request_id", "federation_id", "interoperability_profile", "institution_ids", "disposition", "manifest_digest", "permitted_tags", "checks", "omissions", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-store-P04-F24" },
    "contract_version": { "const": "federated-knowledge-gateway/1.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "interoperability_profile": { "type": "string", "minLength": 1 },
    "institution_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "disposition": { "enum": ["passed", "blocked", "unknown"] },
    "manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "permitted_tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "omissions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
