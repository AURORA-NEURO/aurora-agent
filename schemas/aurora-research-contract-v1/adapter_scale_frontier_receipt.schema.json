{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter_scale_frontier_receipt.schema.json",
  "title": "AURORA adapter prospective scale frontier receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "disposition", "scenario_order", "admissible_order", "blocked_order", "frontier_order", "max_admitted_concurrency", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-scale-frontier/1.0"},
    "feature_id": {"const": "AFA-adapter-P29-F15"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["ready", "partial", "unknown", "blocked"]},
    "scenario_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "admissible_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocked_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "frontier_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "max_admitted_concurrency": {"type": "integer", "minimum": 0},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
