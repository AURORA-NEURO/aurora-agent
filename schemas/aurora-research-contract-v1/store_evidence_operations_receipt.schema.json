{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/store-evidence-operations-receipt.json",
  "title": "AURORA store evidence operations receipt",
  "description": "Prospective high-throughput evidence-stream operations with checkpoint, telemetry, recovery, capacity, and digest-only federation gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "feed_id", "workflow_id", "federation_id", "disposition", "alert_order", "qualified_order", "blocked_order", "unknown_order", "source_order", "provenance_order", "evidence_order", "checkpoint_id", "replay_identity", "telemetry_digest", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "federation_manifest", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "store-prospective-evidence-federated-control-plane/1.0" },
    "feature_id": { "const": "AFA-store-P01-F31" },
    "request_id": { "type": "string", "minLength": 1 },
    "feed_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "federation_id": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "alert_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualified_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "source_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "evidence_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "telemetry_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "federation_manifest": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
