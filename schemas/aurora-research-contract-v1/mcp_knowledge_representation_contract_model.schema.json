{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/mcp-knowledge-representation-contract-model.schema.json",
  "title": "AFA-mcp-P04-F08 federated continual knowledge representation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "semantic_profile", "disposition", "claim_order", "selected_claim_order", "unresolved_claim_order", "blocked_claim_order", "missing_claim_order", "peer_order", "qualified_peer_order", "missing_peer_order", "omission_order", "uncertainty_order", "negative_evidence_order", "replay_identity", "world_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "mcp-federated-continual-knowledge-representation-contract-model/1.0"},
    "feature_id": {"const": "AFA-mcp-P04-F08"},
