{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aurora-neuro.org/schemas/aurora-research-contract-v1/weavelang-federated-commons-assurance.schema.json",
  "title":"AFA WeaveLang prospective federated-commons assurance envelope",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_version","feature_id","request_id","federation_id","requester","purpose","semantic_profile","disposition","capability_order","selected_capability_order","unresolved_capability_order","blocked_capability_order","missing_capability_order","provider_order","selected_provider_order","missing_provider_order","omission_order","uncertainty_order","negative_evidence_order","replay_identity","federation_digest","artifact","effect_receipts","raw_data_local","aggregate_only","boundary"],
  "properties":{
    "schema_version":{"const":"aurora-research-contract/1.0"},"contract_version":{"const":"weavelang-prospective-high-throughput-federated-commons-assurance-harness/1.0"},"feature_id":{"const":"AFA-weavelang-P31-F27"},
    "request_id":{"type":"string","minLength":1},"federation_id":{"type":"string","minLength":1},"requester":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},"semantic_profile":{"type":"string","minLength":1},"disposition":{"enum":["qualified","unresolved","blocked"]},
    "capability_order":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"selected_capability_order":{"type":"array","items":{"type":"string"}},"unresolved_capability_order":{"type":"array","items":{"type":"string"}},"blocked_capability_order":{"type":"array","items":{"type":"string"}},"missing_capability_order":{"type":"array","items":{"type":"string"}},"provider_order":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"selected_provider_order":{"type":"array","items":{"type":"string"}},"missing_provider_order":{"type":"array","items":{"type":"string"}},"omission_order":{"type":"array","items":{"type":"string"}},"uncertainty_order":{"type":"array","items":{"type":"string"}},"negative_evidence_order":{"type":"array","items":{"type":"string"}},
    "replay_identity":{"type":"string","pattern":"^[0-9a-f]{64}$"},"federation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "artifact":{"type":"object","additionalProperties":false,"required":["artifact_id","content_type","content_hash","semantic_loss","provenance_digests","boundary"],"properties":{"artifact_id":{"type":"string","minLength":1},"content_type":{"const":"application/vnd.aurora.weavelang-federation-envelope-8+json"},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"semantic_loss":{"type":"array","items":{"type":"string"}},"provenance_digests":{"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^(block:unsafe-release|verify:weavelang-federation:[^\\s]+)$"}},"raw_data_local":{"const":true},"aggregate_only":{"const":true},"boundary":{"const":"preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
