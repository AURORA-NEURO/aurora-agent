{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/context_assurance_receipt.schema.json",
  "title": "AURORA Federated Context Compilation Assurance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "question_id", "disposition", "context", "checks", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "registry-federated-context-compilation-assurance/1.0"},
    "feature_id": {"const": "AFA-registry-P03-F28"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["compiled", "partial", "unknown", "blocked"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_id", "disposition", "fact_order", "selected_order", "blocked_order", "class_order", "semantic_order", "evidence_order", "provenance_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "context_digest", "boundary"],
      "properties": {
        "context_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["compiled", "partial", "unknown", "blocked"]},
        "fact_order": {"type": "array", "items": {"type": "string"}},
        "selected_order": {"type": "array", "items": {"type": "string"}},
        "blocked_order": {"type": "array", "items": {"type": "string"}},
        "class_order": {"type": "array", "items": {"type": "string"}},
        "semantic_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "omissions": {"type": "array", "items": {"type": "string"}},
        "uncertainty": {"type": "array", "items": {"type": "string"}},
        "negative_evidence": {"type": "array", "items": {"type": "string"}},
        "replay_identity": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^exchange:signed-context-digest:"}, "minItems": 1},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
