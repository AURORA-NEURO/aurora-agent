{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/biolang-publication-copilot-receipt.json",
  "title": "AURORA biolang publication copilot receipt",
  "description": "A bounded A2 publication-preparation queue for validated preclinical runs; declared tools, replay, provenance, benchmark, omission, and raw-data-locality gates remain explicit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "scope", "disposition", "ranked_order", "admitted_order", "blocked_order", "unknown_order", "release_order", "artifact_order", "evidence_order", "tool_invocation_order", "provenance_order", "replay_order", "benchmark_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "benchmark_digest", "effect_receipts", "objects", "publication_artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "contract_version": { "const": "biolang-publication-copilot/1.0" },
    "feature_id": { "const": "AFA-biolang-P16-F11" },
    "request_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["qualified", "partial", "unknown", "blocked"] },
    "ranked_order": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "admitted_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "unknown_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "release_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tool_invocation_order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provenance_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "replay_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "benchmark_order": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "omissions": { "type": "array", "items": { "type": "string" } },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "negative_evidence": { "type": "array", "items": { "type": "string" } },
    "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "benchmark_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "effect_receipts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "objects": { "type": "array", "items": { "type": "object", "required": ["run_id", "release_id", "artifact_ids", "evidence_receipt_ids", "release_digest", "provenance_digest", "replay_identity", "benchmark_digest", "tool_invocations", "raw_data_local", "boundary"], "properties": { "run_id": { "type": "string", "minLength": 1 }, "release_id": { "type": "string", "minLength": 1 }, "artifact_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "evidence_receipt_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "release_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "provenance_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "replay_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "benchmark_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "tool_invocations": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "raw_data_local": { "const": true }, "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" } }, "additionalProperties": false } },
    "publication_artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": true },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
