{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/brain-high-throughput-evidence-workflow-fabric-receipt.json",
  "title": "AURORA brain high-throughput evidence workflow fabric receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "batch_id", "partition", "disposition", "stage_order", "plan_order", "completed_order", "blocked_order", "compensation_order", "candidate_order", "admitted_order", "unknown_order", "checkpoint_seq", "queue_digest", "checkpoint_digest", "workflow_digest", "approval_reference", "replay_identity", "budget_units", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"}, "contract_version": {"const": "brain-high-throughput-evidence-workflow-fabric/1.0"}, "feature_id": {"const": "AFA-brain-P01-F15"}, "request_id": {"type": "string", "minLength": 1}, "workflow_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "partition": {"type": "string", "minLength": 1}, "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "stage_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "plan_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "completed_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "blocked_order": {"type": "array", "items": {"type": "string"}}, "compensation_order": {"type": "array", "items": {"type": "string"}}, "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "admitted_order": {"type": "array", "items": {"type": "string"}}, "unknown_order": {"type": "array", "items": {"type": "string"}}, "checkpoint_seq": {"type": "integer", "minimum": 0},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval_reference": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "budget_units": {"type": "integer", "minimum": 1}, "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true}, "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
