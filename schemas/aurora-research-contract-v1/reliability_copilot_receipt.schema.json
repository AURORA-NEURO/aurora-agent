{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/reliability_copilot_receipt.schema.json",
  "title": "AURORA federated reliability copilot receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "workload_id", "decision", "invocation_order", "retry_order", "tool_order", "budget_used_units", "timeout_order", "omissions", "uncertainty", "failure_reasons", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "federated-reliability-copilot/1.0"},
    "feature_id": {"const": "AFA-adapter-P21-F12"},
    "workload_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["completed", "dry_run", "partial", "degraded", "blocked"]},
    "invocation_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "retry_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tool_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "budget_used_units": {"type": "integer", "minimum": 0},
    "timeout_order": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "failure_reasons": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
