{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/quality-drift-receipt.json",
  "title": "AURORA quality drift receipt",
  "description": "Baseline-relative continual-ingestion quality comparison with explicit stable, drifted, unknown, and blocked states.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_id", "dataset_id", "modality", "request_digest", "summary", "metrics", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": { "const": "aurora-research-contract/1.0" },
    "feature_id": { "const": "AFA-adapter-P07-F02" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "modality": { "type": "string", "minLength": 1 },
    "request_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": {
      "type": "object",
      "required": ["disposition", "measured", "stable", "drifted", "unknown", "reasons"],
      "properties": {
        "disposition": { "enum": ["stable", "drifted", "unknown", "blocked"] },
        "measured": { "type": "integer", "minimum": 0 },
        "stable": { "type": "integer", "minimum": 0 },
        "drifted": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "status", "delta", "reasons"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["stable", "drifted", "unknown"] },
          "delta": { "type": ["number", "null"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifact": { "type": "object", "required": ["content_hash"], "properties": { "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "raw_data_local": { "const": true },
    "boundary": { "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions" }
  }
}
