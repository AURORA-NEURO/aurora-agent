{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/governance_interpretation_assurance_receipt.schema.json",
  "title": "AURORA Governance Interpretation Assurance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "workflow_id", "objective_id", "scope", "disposition", "ranked_order", "admitted_order", "blocked_order", "unknown_order", "result_order", "visualization_order", "support_order", "semantic_order", "artifact_order", "evidence_order", "provenance_order", "baseline_order", "omissions", "uncertainty", "negative_evidence", "replay_identity", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "governance-interpretation-assurance/1.0"},
    "feature_id": {"const": "AFA-governance-P14-F27"},
    "request_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "objective_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "ranked_order": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "result_order": {"type": "array", "items": {"type": "string"}},
    "visualization_order": {"type": "array", "items": {"type": "string"}},
    "support_order": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 1000}},
    "semantic_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "artifact_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "provenance_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "baseline_order": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"$ref": "#/$defs/digest"},
    "effect_receipts": {"type": "array", "items": {"type": "string", "pattern": "^(evaluate:interpretation-assurance:|block:interpretation-assurance-release$)"}, "minItems": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"$ref": "#/$defs/digest"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
