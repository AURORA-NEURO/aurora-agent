{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-computational-execution-p12-f15.json",
  "title": "AFA-worldgen-P12-F15 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "workflow_id",
    "disposition",
    "stage_order",
    "completed_stage_order",
    "pending_stage_order",
    "compensation_order",
    "checkpoint_seq",
    "budget_units",
    "consumed_units",
    "replay_identity",
    "copilot",
    "workflow_digest",
    "artifact",
    "effect_receipts",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ],
  "properties": {
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "budget_units": {
      "type": "integer"
    },
    "feature_id": {
      "const": "AFA-worldgen-P12-F15"
    },
    "schema_version": {
      "type": "string"
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    },
    "copilot": {
      "type": "object"
    },
    "checkpoint_seq": {
      "type": "integer"
    },
    "compensation_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workflow_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "disposition": {
      "type": "string"
    },
    "stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "content_type",
        "content_hash",
        "boundary"
      ],
      "properties": {
        "boundary": {
          "type": "string"
        },
        "content_type": {
          "const": "application/vnd.aurora.worldgen.execution-workflow-receipt+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "contract_version": {
      "const": "worldgen-throughput-computational_execution-workflow/1.0"
    },
    "raw_data_local": {
      "const": true
    },
    "workflow_id": {
      "type": "string"
    },
    "consumed_units": {
      "type": "integer"
    },
    "completed_stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
