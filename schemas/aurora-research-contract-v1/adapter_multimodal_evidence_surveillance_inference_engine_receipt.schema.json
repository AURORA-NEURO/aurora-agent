{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter-multimodal-evidence-surveillance-inference-engine-receipt.json",
  "title": "AURORA adapter multimodal evidence surveillance inference engine receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "intent", "semantic_profile", "disposition", "study_order", "modality_order", "candidate_order", "ranked_order", "selected_order", "unresolved_order", "denied_order", "comparability_digest", "evidence_digest", "provenance_digest", "replay_identity", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "qualified_set", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-multimodal-evidence-surveillance-inference-engine/1.0"},
    "feature_id": {"const": "AFA-adapter-P01-F02"},
    "request_id": {"type": "string", "minLength": 1}, "intent": {"type": "string", "minLength": 1}, "semantic_profile": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["completed", "partial", "unknown", "blocked"]},
    "study_order": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "modality_order": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "ranked_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selected_order": {"type": "array", "items": {"type": "string"}}, "unresolved_order": {"type": "array", "items": {"type": "string"}}, "denied_order": {"type": "array", "items": {"type": "string"}},
    "comparability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "provenance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}}, "uncertainty": {"type": "array", "items": {"type": "string"}}, "negative_evidence": {"type": "array", "items": {"type": "string"}}, "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualified_set": {"type": "object"}, "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
