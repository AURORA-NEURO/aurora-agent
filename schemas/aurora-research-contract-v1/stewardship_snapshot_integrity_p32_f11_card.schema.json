{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AURORA Stewardship Snapshot Integrity Card F11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "purpose",
    "snapshot_id",
    "quarter",
    "disposition",
    "item_order",
    "accepted_order",
    "rejected_order",
    "unknown_order",
    "omitted_order",
    "owner_order",
    "reviewer_order",
    "retention_order",
    "negative_order",
    "checksum_order",
    "replay_identity",
    "closure_digest",
    "raw_data_local",
    "aggregate_only",
    "boundary",
    "effect_receipts",
    "artifact"
  ],
  "properties": {
    "schema_version": {
      "const": "aurora-research-contract/1.0"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "const": "AFA-stewardship-P32-F11"
    },
    "request_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "quarter": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked"
      ]
    },
    "item_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "accepted_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rejected_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "unknown_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "omitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewer_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "retention_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "negative_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checksum_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "closure_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_type",
        "content_hash",
        "semantic_loss",
        "evidence_digests",
        "boundary"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "content_type": {
          "const": "application/vnd.aurora.stewardship.snapshot-integrity-card-1+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_loss": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "boundary": {
          "const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"
        }
      }
    }
  }
}
