{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/adapter-federated-continual-retrieval-synthesis-assurance-harness-receipt.json",
  "title": "AURORA adapter federated continual retrieval synthesis assurance harness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "baseline_id", "scope", "federation_id", "purpose", "peer_ids", "min_peer_quorum", "aggregate_only", "endpoint", "verdict", "check_order", "passed_checks", "counterexamples", "candidate_order", "selected_order", "omitted_order", "overflow_order", "uncertainty_order", "negative_order", "contradictory_order", "replay_identity", "workflow_run_digest", "workbench_digest", "assurance_digest", "omissions", "uncertainty", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "adapter-federated-continual-retrieval-synthesis-assurance-harness/1.0"},
    "feature_id": {"const": "AFA-adapter-P02-F28"},
    "request_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "peer_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "min_peer_quorum": {"type": "integer", "minimum": 1},
    "aggregate_only": {"const": true},
    "endpoint": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["passed", "blocked", "unknown"]},
    "check_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "passed_checks": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selected_order": {"type": "array", "items": {"type": "string"}},
    "omitted_order": {"type": "array", "items": {"type": "string"}},
    "overflow_order": {"type": "array", "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}},
    "negative_order": {"type": "array", "items": {"type": "string"}},
    "contradictory_order": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workbench_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assurance_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash", "media_type"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"const": "application/vnd.aurora.federated-continual-retrieval-synthesis-assurance+json"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
