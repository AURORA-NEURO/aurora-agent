{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Megafactory factory lineage integrity card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "purpose", "disposition", "stage_order", "admitted_order", "rejected_order", "unknown_order", "omitted_order", "lineage_order", "consumer_order", "contract_order", "effect_order", "replay_identity", "closure_digest", "admitted_stage_count", "total_stage_count", "raw_data_local", "aggregate_only", "boundary", "effect_receipts", "artifact"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "pattern": "^AFA-megafactory-P32-F(0[1-9]|1[0-6])$"},
    "request_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "partial", "unknown", "blocked"]},
    "stage_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "admitted_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rejected_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unknown_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "omitted_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "lineage_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "consumer_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contract_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effect_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "closure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "admitted_stage_count": {"type": "integer", "minimum": 0},
    "total_stage_count": {"type": "integer", "minimum": 0},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_type", "content_hash", "semantic_loss", "evidence_digests", "boundary"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.megafactory.factory-lineage-integrity-card-1+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    }
  }
}
