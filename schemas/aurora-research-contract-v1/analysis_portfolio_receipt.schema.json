{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/analysis_portfolio_receipt.schema.json",
  "title": "AURORA local analysis model portfolio receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "question_id", "estimand", "verdict", "selected_candidate", "candidate_order", "uncertainty", "omissions", "negative_evidence", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "local-analysis-model-portfolio/1.0"},
    "feature_id": {"const": "AFA-adapter-P13-F01"},
    "question_id": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["qualified", "conditional", "blocked"]},
    "selected_candidate": {"type": ["string", "null"]},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
