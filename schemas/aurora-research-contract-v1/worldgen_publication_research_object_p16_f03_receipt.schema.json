{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/worldgen-publication-research-object-p16-f03.json",
  "title": "AFA-worldgen-P16-F03 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "study_id",
    "scope",
    "disposition",
    "candidate_order",
    "selected_order",
    "unresolved_order",
    "blocked_order",
    "omitted_order",
    "validation_score_milli",
    "uncertainty_milli",
    "release_item_order",
    "manifest_item_order",
    "decisions",
    "replay_identity",
    "release_digest",
    "semantic_loss",
    "omissions",
    "uncertainty",
    "contradiction",
    "negative_evidence",
    "artifact",
    "effect_receipts",
    "raw_data_local",
    "federation_export",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "const": "worldgen-throughput-publication-research-object/1.0"
    },
    "feature_id": {
      "const": "AFA-worldgen-P16-F03"
    },
    "request_id": {
      "type": "string"
    },
    "study_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "qualified",
        "unresolved",
        "blocked"
      ]
    },
    "candidate_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "omitted_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_score_milli": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "uncertainty_milli": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "release_item_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array"
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_loss": {
      "type": "array"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradiction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_data_local": {
      "const": true
    },
    "federation_export": {
      "const": "aggregate-digest-only"
    },
    "boundary": {
      "type": "string"
    },
    "artifact": {
      "type": "object",
      "required": [
        "content_type",
        "content_hash",
        "boundary"
      ],
      "properties": {
        "content_type": {
          "const": "application/vnd.aurora.worldgen.publication-research-object-result+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary": {
          "type": "string"
        }
      }
    },
    "manifest_item_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
