{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/services-federated-publication-release-inference-receipt.json",
  "title": "AURORA federated publication-release inference receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "federation_id", "purpose", "semantic_profile", "admission", "origin_order", "qualified_origin_order", "candidate_order", "rank_order", "qualified_order", "conditional_order", "blocked_order", "unknown_order", "decisions", "checkpoint_seq", "checkpoint_digest", "inference_digest", "replay_identity", "semantic_loss", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "services-federated-continual-publication-release-inference/1.0"},
    "feature_id": {"const": "AFA-services-P16-F04"},
    "request_id": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "admission": {"enum": ["qualified", "degraded", "blocked", "unknown"]},
    "origin_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualified_origin_order": {"type": "array", "items": {"type": "string"}},
    "candidate_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rank_order": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualified_order": {"type": "array", "items": {"type": "string"}},
    "conditional_order": {"type": "array", "items": {"type": "string"}},
    "blocked_order": {"type": "array", "items": {"type": "string"}},
    "unknown_order": {"type": "array", "items": {"type": "string"}},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_id", "origin", "score", "disposition", "failed_gates", "conditional_gates", "negative_result"],
        "properties": {
          "release_id": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1},
          "score": {"type": "integer"},
          "disposition": {"enum": ["qualified", "conditional", "blocked"]},
          "failed_gates": {"type": "array", "items": {"type": "string"}},
          "conditional_gates": {"type": "array", "items": {"type": "string"}},
          "negative_result": {"type": "boolean"}
        }
      }
    },
    "checkpoint_seq": {"type": "integer", "minimum": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inference_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"],
      "properties": {
        "schema_version": {"const": "aurora-research-contract/1.0"},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_type": {"const": "application/vnd.aurora.publication-release-inference+json"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_loss": {"type": "array", "items": {"type": "object"}},
        "provenance": {"type": "array", "items": {"type": "object"}},
        "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
      }
    },
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}


