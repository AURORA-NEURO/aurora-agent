{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFA-worldgen-P20-F12 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "disposition",
    "action_order",
    "admitted_action_order",
    "denied_action_order",
    "security_disposition",
    "security_digest",
    "copilot_digest",
    "replay_identity",
    "omissions",
    "threat_order",
    "revocation_order",
    "effect_receipts",
    "artifact",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "const": "AFA-worldgen-P20-F12"
    },
    "request_id": {
      "type": "string"
    },
    "disposition": {
      "type": "string"
    },
    "action_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "admitted_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_disposition": {
      "type": "string"
    },
    "security_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "copilot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "threat_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revocation_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "content_hash",
        "boundary"
      ],
      "properties": {
        "content_type": {
          "const": "application/vnd.aurora.worldgen.security-federation-copilot-receipt+json"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary": {
          "const": "preclinical-research"
        }
      }
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "const": "preclinical-research"
    }
  }
}
