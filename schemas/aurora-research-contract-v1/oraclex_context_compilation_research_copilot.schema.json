{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/oraclex-context-compilation-research-copilot.schema.json",
  "title": "AFA-oraclex-P03-F12 certified decision section",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "consumer", "federation_id", "purpose", "semantic_profile", "target_schema", "disposition", "fact_order", "selected_fact_order", "unresolved_fact_order", "blocked_fact_order", "missing_fact_order", "peer_order", "qualified_peer_order", "missing_peer_order", "tool_plan_order", "omission_order", "uncertainty_order", "negative_evidence_order", "replay_identity", "section_digest", "evidence_digest", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "oraclex-federated-context-compilation-copilot/1.0"},
    "feature_id": {"const": "AFA-oraclex-P03-F12"},
    "request_id": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "federation_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "semantic_profile": {"type": "string", "minLength": 1},
    "target_schema": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "fact_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "selected_fact_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_fact_order": {"type": "array", "items": {"type": "string"}},
    "blocked_fact_order": {"type": "array", "items": {"type": "string"}},
    "missing_fact_order": {"type": "array", "items": {"type": "string"}},
    "peer_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "qualified_peer_order": {"type": "array", "items": {"type": "string"}},
    "missing_peer_order": {"type": "array", "items": {"type": "string"}},
    "tool_plan_order": {"type": "array", "items": {"type": "string"}},
    "omission_order": {"type": "array", "items": {"type": "string"}},
    "uncertainty_order": {"type": "array", "items": {"type": "string"}},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "section_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.certified-decision-section-3+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
