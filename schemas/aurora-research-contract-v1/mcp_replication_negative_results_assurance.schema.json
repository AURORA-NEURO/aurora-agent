{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/mcp-replication-negative-results-assurance.schema.json",
  "title": "AURORA MCP prospective replication and negative-results assurance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "claim_id", "disposition", "observation_order", "qualified_order", "unresolved_order", "blocked_order", "positive_order", "null_order", "negative_order", "inconclusive_order", "site_order", "missing_site_order", "omission_order", "negative_evidence_order", "effect_median_milli", "positive_count", "null_count", "negative_count", "batch_limit", "replay_identity", "record_digest", "artifact", "effect_receipts", "raw_data_local", "aggregate_only", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "mcp-prospective-high-throughput-replication-negative-results-assurance/1.0"},
    "feature_id": {"const": "AFA-mcp-P15-F27"},
    "request_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["qualified", "unresolved", "blocked"]},
    "observation_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "qualified_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blocked_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "positive_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "null_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "negative_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inconclusive_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "site_order": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "missing_site_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "omission_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "negative_evidence_order": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "effect_median_milli": {"type": "integer"},
    "positive_count": {"type": "integer", "minimum": 0},
    "null_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "batch_limit": {"type": "integer", "minimum": 1, "maximum": 16384},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "required": ["schema_version", "artifact_id", "content_type", "content_hash", "semantic_loss", "provenance", "boundary"], "properties": {"schema_version": {"const": "aurora-research-contract/1.0"}, "artifact_id": {"type": "string", "minLength": 1}, "content_type": {"const": "application/vnd.aurora.mcp-replication-record-7+json"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_loss": {"type": "array"}, "provenance": {"type": "array"}, "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}, "additionalProperties": true}},
    "effect_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "raw_data_local": {"const": true},
    "aggregate_only": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
