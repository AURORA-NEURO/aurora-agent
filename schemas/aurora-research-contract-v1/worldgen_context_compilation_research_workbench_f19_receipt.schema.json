{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/context_compilation_research_workbench_receipt.schema.json",
  "title": "ContextWorkbenchReceipt1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "contract_version": {
      "type": "string"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^AFA-worldgen-P03-F(17|18|19|20)$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "qualified",
        "partial",
        "unknown",
        "blocked"
      ]
    },
    "view_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "panel_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_fact_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_fact_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_fact_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_fact_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "denied_action_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "replay_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "copilot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workbench_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "negative_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effect_receipts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object"
    },
    "raw_data_local": {
      "const": true
    },
    "aggregate_only": {
      "const": true
    },
    "boundary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "feature_id",
    "request_id",
    "workspace_id",
    "scope",
    "disposition",
    "view_order",
    "panel_order",
    "required_fact_order",
    "resolved_fact_order",
    "unknown_fact_order",
    "blocked_fact_order",
    "denied_action_order",
    "replay_identity",
    "copilot_digest",
    "workbench_digest",
    "omissions",
    "uncertainty",
    "negative_evidence",
    "effect_receipts",
    "artifact",
    "raw_data_local",
    "aggregate_only",
    "boundary"
  ]
}
