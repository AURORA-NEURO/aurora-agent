{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/brain/local-knowledge-representation-contract-model-receipt-1.0.json",
  "title": "AFA-brain-P04-F05 local knowledge representation contract model receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "request_id", "study_id", "disposition", "input_schema", "output_schema", "source_revision", "target_revision", "candidate_order", "admitted_order", "unresolved_order", "denied_order", "missing_order", "semantic_loss_order", "contract_digest", "migration_digest", "replay_identity", "omissions", "uncertainty", "negative_evidence", "effect_receipts", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "brain-local-knowledge-representation-contract-model/1.0"},
    "feature_id": {"const": "AFA-brain-P04-F05"},
    "request_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["compatible", "migrated", "partial", "blocked"]},
    "input_schema": {"const": "ScopedResearchClaims1@1"},
    "output_schema": {"const": "TypedKnowledgeWorld1@1"},
    "source_revision": {"type": "integer", "minimum": 1},
    "target_revision": {"type": "integer", "minimum": 1},
    "candidate_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "admitted_order": {"type": "array", "items": {"type": "string"}},
    "unresolved_order": {"type": "array", "items": {"type": "string"}},
    "denied_order": {"type": "array", "items": {"type": "string"}},
    "missing_order": {"type": "array", "items": {"type": "string"}},
    "semantic_loss_order": {"type": "array", "items": {"type": "string"}},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "omissions": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "negative_evidence": {"type": "array", "items": {"type": "string"}},
    "effect_receipts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical-research-only; no human-subject or clinical-source data; no diagnosis, treatment, triage, enrollment, or clinical decisions"}
  }
}
