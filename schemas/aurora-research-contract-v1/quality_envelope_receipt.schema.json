{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-neuro.org/schemas/aurora-research-contract-v1/quality_envelope_receipt.schema.json",
  "title": "AURORA multi-study quality envelope receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "feature_id", "envelope_id", "reference_schema", "comparability_profile", "decision", "study_order", "modality_coverage", "verdicts", "omitted_modalities", "comparability_conflicts", "semantic_loss", "reasons", "artifact", "raw_data_local", "boundary"],
  "properties": {
    "schema_version": {"const": "aurora-research-contract/1.0"},
    "contract_version": {"const": "multi-study-quality-envelope/1.0"},
    "feature_id": {"const": "AFA-adapter-P07-F06"},
    "envelope_id": {"type": "string", "minLength": 1},
    "reference_schema": {"type": "string", "minLength": 1},
    "comparability_profile": {"type": "string", "minLength": 1},
    "decision": {"enum": ["qualified", "partial", "blocked", "unknown"]},
    "study_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "modality_coverage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "verdicts": {"type": "array", "items": {"type": "object", "required": ["study_id", "modality", "quality_disposition", "comparable", "reasons"], "properties": {"study_id": {"type": "string", "minLength": 1}, "modality": {"type": "string", "minLength": 1}, "quality_disposition": {"enum": ["pass", "pass_with_warnings", "blocked", "unknown"]}, "comparable": {"type": "boolean"}, "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": true}},
    "omitted_modalities": {"type": "array", "items": {"type": "string"}},
    "comparability_conflicts": {"type": "array", "items": {"type": "string"}},
    "semantic_loss": {"type": "array", "items": {"type": "object"}},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {"type": "object", "required": ["content_hash"], "properties": {"content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": true},
    "raw_data_local": {"const": true},
    "boundary": {"const": "preclinical_research_only"}
  }
}
